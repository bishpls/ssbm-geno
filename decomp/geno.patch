+/* animation-pipeline: Geno's specials (DESIGN.md v1.1 ¬ß5), the fighter side.
+ *   Neutral B  Geno Beam: hold to charge through three stars (15/30/45), release to fire; a tap fires Finger Shot. No
+ *              store (Michael, 2026-09-28: not Samus's or Mewtwo's charge shot): a shield press cancels the charge and its
+ *              stars are lost; just past the third star's timed window it fires by itself.
+ *   Side B     Geno Whirl: throw the disc (one in play); side B again in flight is the timed hit (no recall since v1.5).
+ *   Up B       Star Road: fold into the cannon, aim (16 directions), travel 20 frames with no hitbox after the launch,
+ *              then helpless; the ledge catches from travel frame 4 (descending), and steeply into a wall slides along it.
+ *   Down B     Geno Blast: place a mark by the stick; hold to widen (second star) and, at the third, Geno Flash.
+ * Every projectile spawns on the move script's flag (fcmd `flag()`, throw_flags_b0), polled here each frame; the items
+ * themselves (ftGe_Spawn*) are the next stage. */
+#include <melee/it/kinds/itgeno.h>
+#include <melee/ef/efasync.h>
+#include <melee/ef/efsync.h>
+#include "ftgeno_efge.h"
+#include <melee/ef/eflib.h>
+#include <sysdolphin/baselib/psstructs.h>
+#include <melee/gm/gmvs.h>
+#include <melee/ft/ft_0877.h>
+#include <melee/ft/ft_0881.h>
+#include <melee/lb/lb_00B0.h>
+#include <melee/mp/mplib.h>
+#include <melee/ft/ftparts.h>
+#include "ftgeno.h"
+#ifndef MUST_MATCH
+#define FTGE_RIG_DEFINES_ONLY /* the cannon's joint indices and its muzzle; the parts tables stay in ftgeno.c */
+#include "ftgeno_rig.inc"
+#endif
+
+#include <dolphin/os.h>
+#include <math.h>
+#include <melee/ft/ftcamera.h>
+#include <melee/ft/ftcolanim.h>
+#include <melee/ft/fighter.h>
+#include <melee/ft/ft_081B.h>
+#include <melee/ft/ft_084E.h>
+#include <melee/ft/ft_0892.h>
+#include <melee/ft/ftanim.h>
+#include <melee/ft/ftcliffcommon.h>
+#include <melee/ft/ftcommon.h>
