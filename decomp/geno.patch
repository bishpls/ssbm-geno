+    BV(ip).age = 0;
+    ip->pos = pos;
+    Item_80268E5C(g, GE_BLAST_MARK, ITEM_ANIM_UPDATE);
+    itGe_BlastColour(g);
+    db_80225DD8(g, owner);
+    return g;
+}
