+void ftGe_Init_OnItemDrop(HSD_GObj* gobj, bool flag);
+
+/* Geno's motion states (after the common ones, as every kind's own start at ftCo_MS_Count) and the action-table entries
+ * they play (after the common ones, from ftCo_SM_Count = 0x127) */
+enum ftGe_MotionState {
+    ftGe_MS_AppealSR = 341,
+    ftGe_MS_AppealSL,
+    ftGe_MS_SpecialNStart,
+    ftGe_MS_SpecialNLoop,
+    ftGe_MS_SpecialNEnd,
+    ftGe_MS_SpecialAirNStart,
+    ftGe_MS_SpecialAirNLoop,
+    ftGe_MS_SpecialAirNEnd,
+    ftGe_MS_SpecialS,
+    ftGe_MS_SpecialAirS,
+    ftGe_MS_SpecialHiStart,
+    ftGe_MS_SpecialAirHiStart,
+    ftGe_MS_SpecialHi,
+    ftGe_MS_SpecialLw,
+    ftGe_MS_SpecialAirLw,
+    ftGe_MS_SpecialLwFlash,
+    ftGe_MS_SpecialNFinger,
+    ftGe_MS_SpecialAirNFinger,
+#ifndef MUST_MATCH
+    ftGe_MS_SpecialNCancel,    /* the shield cancel (Samus's and Mewtwo's charge cancel; the stars are lost) */
+    ftGe_MS_SpecialAirNCancel,
+    ftGe_MS_SpecialLwEnd,      /* down B's release: the Blast's mark (SpecialLw and SpecialAirLw are its charge) */
+    ftGe_MS_SpecialAirLwEnd,
+#endif
+    ftGe_MS_Count
+};
+enum ftGe_Submotion {
+    ftGe_SM_SpecialNStart = 0x127,
+    ftGe_SM_SpecialNLoop,
+    ftGe_SM_SpecialNEnd,
+    ftGe_SM_SpecialAirNStart,
+    ftGe_SM_SpecialAirNLoop,
+    ftGe_SM_SpecialAirNEnd,
+    ftGe_SM_SpecialS,
+    ftGe_SM_SpecialAirS,
+    ftGe_SM_SpecialHiStart,
+    ftGe_SM_SpecialAirHiStart,
+    ftGe_SM_SpecialHi,
+    ftGe_SM_SpecialLw,
+    ftGe_SM_SpecialAirLw,
+    ftGe_SM_SpecialLwFlash,
+    ftGe_SM_SpecialNFinger,
+    ftGe_SM_SpecialAirNFinger,
+#ifndef MUST_MATCH
+    ftGe_SM_SpecialNCancel,
+    ftGe_SM_SpecialAirNCancel,
+    ftGe_SM_SpecialLwEnd,
+    ftGe_SM_SpecialAirLwEnd,
+#endif
+    ftGe_SM_Count /* 0x13B = 315: the action table's length */
+};
+
+extern MotionState ftGe_Init_MotionStateTable[ftGe_MS_Count - ftGe_MS_AppealSR];
+void ftGe_SpecialN_Enter(Fighter_GObj* gobj);
