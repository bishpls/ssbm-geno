+        if (fp->kind == Ft_Kind_Geno) {
+            ftGe_MuzzlePos(gobj, &pos, GE_PART_RHAND, GE_BEAM_MUZZLE, "timed stars");
+        } else {
+            ftGe_MuzzlePos(gobj, &pos, FtPart_RHandN, 0.0f, "timed stars (copy)");
+        }
+        OSReport("GENO TIMED STARS %s\n", efSync_Spawn(GE_EF_TIMED_STARS, gobj, &pos) != NULL ? "spawned" : "failed");
+    } else {
+        ftCo_800BFFD0(fp, GE_COLANIM_TIMED, 0);
+    }
+}
