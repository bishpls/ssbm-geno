+#define GE_BLAST_MID 50.0f
+#define GE_BLAST_SPREAD 14.0f /* the second star: three columns, this far apart */
+/* v1.5 (Michael, 2026-09-30: "the 3 possible stage-1 mark positions match the CURRENT stage-2 laser positions"): the
+ * stick picks the mark from star 2's three columns, 36, 50 and 64 ahead (were 25, 50, 75) */
+#define GE_BLAST_NEAR (GE_BLAST_MID - GE_BLAST_SPREAD)
+#define GE_BLAST_FAR (GE_BLAST_MID + GE_BLAST_SPREAD)
+
+#ifndef MUST_MATCH
+/* animation-pipeline (geno-atk-air): each column strikes the floor under its own mark, as SMRPG's beams come down from
+ * the sky, wherever Geno is. The mark's height used to be his (fp->cur_pos.y), so an airborne cast ended its column at
+ * his height, over the opponent's head. A ray per column finds the first floor below: from 20 above his height (a step
+ * or a slope up ahead is found; a platform over his head isn't) to 200 below; the widened columns 14 either side can sit
+ * over another floor or a platform's edge. Over the void (no floor within reach) the column still sweeps its 50 down
+ * from his height (the strike's drop) instead of stopping at his feet. */
+#define GE_BLAST_RAY_UP 20.0f
+#define GE_BLAST_RAY_DOWN 400.0f /* v1.5: from any height he can cast at */
+#define GE_BLAST_VOID_DROP 50.0f
+#define GE_BLAST_EDGE_STEP 4.0f  /* v1.5: over the void, look back toward the stage this far at a time ... */
+#define GE_BLAST_EDGE_REACH 120.0f /* ... up to this far */
+
+static bool ftGe_BlastRay(f32 x, f32 y, f32* out)
+{
+    Vec3 hit, normal;
+    int line;
+    u32 flags;
+    if (mpCheckFloor(x, y + GE_BLAST_RAY_UP, x, y - GE_BLAST_RAY_DOWN, 0.0f, &hit, &line, &flags, &normal, -1, -1, -1,
+                     NULL, NULL))
+    {
+        *out = hit.y;
+        return true;
+    }
+    return false;
+}
+
+/* v1.5 (Michael, 2026-09-30: offstage and high casts placed the mark oddly): a column strikes the first floor under its
+ * mark. Over the void it strikes the plane of the nearest floor back toward the stage (its ledge's height), so an
+ * offstage mark sits level with the stage instead of hanging 50 below wherever he happened to be; with no floor
+ * anywhere near, 50 below him as before. */
+static f32 ftGe_BlastFloor(Fighter* fp, f32 x)
+{
+    f32 y = fp->cur_pos.y, fy, d, dir = x > 0.0f ? -1.0f : 1.0f;
+    if (ftGe_BlastRay(x, y, &fy)) {
+        return fy;
+    }
+    for (d = GE_BLAST_EDGE_STEP; d <= GE_BLAST_EDGE_REACH; d += GE_BLAST_EDGE_STEP) {
+        if (ftGe_BlastRay(x + dir * d, y, &fy)) {
+            OSReport("GENO BLAST over the void: the stage's plane %d, %d back (x100)\n", (int) (fy * 100.0f),
+                     (int) (d * 100.0f));
+            return fy;
+        }
+    }
+    return y - GE_BLAST_VOID_DROP;
+}
+
+/* v1.5 (Michael, 2026-09-30): the mark shows from the move's first frame, all three marks the moment the second star
+ * lights, and they go when the cannon commits (the third star, grounded); a release strikes the marks shown.
+ * The forgiving mark (Michael: "read the stick at any point in the charge before level 2 to place the mark"): the stick
+ * picks near, mid or far (36, 50, 64 ahead) at the press and on every frame of the charge after it, and the one mark
+ * slides there (the same item, moved: its tell keeps animating); it locks when the second star lights, or when B is let
+ * go first (a tap keeps the last reading made with B held). The press reads the stick past 0.25 either way (inside down B's band: |x|
+ * under 0.6); after it the stick is free, so the charge moves the mark only past 0.5 and brings it back to mid only
+ * under 0.25: a stick resting at a boundary never flickers the mark. The places are measured from where he pressed
+ * (mv.ge.vx), so an aerial drift doesn't creep the mark. The mark's x is kept in mv.ge.angle (down B has no bend), the
+ * zone and the lock in mv.ge.flags. */
+#define GE_BLAST_PRESS_X 0.25f  /* the press: past this either way, near or far */
+#define GE_BLAST_ENTER_X 0.5f   /* the charge: past this, near or far ... */
+#define GE_BLAST_LEAVE_X 0.25f  /* ... and back to mid only inside this */
+#define GE_BLAST_SLIDE 5.0f     /* units a frame the mark slides (14 between marks: 3 frames) */
+#define GE_BLAST_ZONE 0x3000    /* mv.ge.flags: the mark's zone, 0 near, 1 mid, 2 far (<< 12) */
+#define GE_BLAST_LOCKED 0x4000  /* mv.ge.flags: the mark is locked (star 2 or B let go) */
+#define GE_BLAST_ZONE_OF(fp) (((fp)->mv.ge.flags & GE_BLAST_ZONE) >> 12)
+static const f32 ftGe_BlastDist[3] = { GE_BLAST_NEAR, GE_BLAST_MID, GE_BLAST_FAR };
+
+static void ftGe_BlastColumn(Fighter_GObj* gobj, f32 cx)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    f32 fy = ftGe_BlastFloor(fp, cx);
+    OSReport("GENO BLAST column x %d floor %d (x100)\n", (int) (cx * 100.0f), (int) (fy * 100.0f));
+    itGe_SpawnBlast(gobj, cx, fy, fp->facing_dir);
+}
+
+static void ftGe_BlastPlace(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    f32 sx = fp->input.lstick[0].x * fp->facing_dir; /* forward is positive */
+    /* the press is a down B only with y below -0.55 and |x| under 0.6 (side B from 0.6): past 0.25 either way picks the
+     * near or far mark, so down-back and down-forward (20-37 degrees off straight down) both still read as down B */
+    int z = sx > GE_BLAST_PRESS_X ? 2 : sx < -GE_BLAST_PRESS_X ? 0 : 1;
+    int live = itGe_CountOwned(gobj, It_Kind_Geno_Blast);
+    fp->mv.ge.flags = (fp->mv.ge.flags & ~(GE_BLAST_ZONE | GE_BLAST_LOCKED)) | (z << 12);
+    fp->mv.ge.vx = fp->cur_pos.x; /* the places' origin */
+    fp->mv.ge.angle = fp->mv.ge.vx + fp->facing_dir * ftGe_BlastDist[z];
+    OSReport("GENO BLAST mark at the press: dist %d live %d geno_y %d (x100)\n", (int) ftGe_BlastDist[z], live,
+             (int) (fp->cur_pos.y * 100.0f));
+    if (live > 0) {
+        fp->mv.ge.flags |= GE_BLAST_NONE; /* one set of marks at a time: this cast marks nothing */
+        return;
+    }
+    ftGe_BlastColumn(gobj, fp->mv.ge.angle);
+}
+
+/* the charge, each frame until the lock: read the stick (with its deadzone; not on B's release frame, where the
+ * last reading with B held stands), slide the mark toward its zone's place; a lock snaps it there */
+static void ftGe_BlastSteer(Fighter_GObj* gobj, bool read, bool lock)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    f32 sx = fp->input.lstick[0].x * fp->facing_dir;
+    int z = GE_BLAST_ZONE_OF(fp), z0 = z;
+    f32 to, x;
+    if (fp->mv.ge.flags & GE_BLAST_LOCKED) {
+        return;
+    }
+    if (!read) {
+        /* B let go: lock where the last reading put it */
+    } else if (sx >= GE_BLAST_ENTER_X) {
+        z = 2;
+    } else if (sx <= -GE_BLAST_ENTER_X) {
+        z = 0;
+    } else if ((z == 2 && sx < GE_BLAST_LEAVE_X) || (z == 0 && sx > -GE_BLAST_LEAVE_X)) {
+        z = 1;
+    }
+    fp->mv.ge.flags = (fp->mv.ge.flags & ~GE_BLAST_ZONE) | (z << 12);
+    to = fp->mv.ge.vx + fp->facing_dir * ftGe_BlastDist[z];
+    x = fp->mv.ge.angle;
+    if (lock || (to - x <= GE_BLAST_SLIDE && x - to <= GE_BLAST_SLIDE)) {
+        x = to; /* there (or locked: snapped there) */
+    } else {
+        x += to > x ? GE_BLAST_SLIDE : -GE_BLAST_SLIDE;
+    }
+    if (z != z0) {
+        OSReport("GENO BLAST mark zone %d -> %d (stick %d)\n", z0, z, (int) (sx * 100.0f));
+    }
+    if (lock) {
+        fp->mv.ge.flags |= GE_BLAST_LOCKED;
+        OSReport("GENO BLAST mark locked: dist %d x %d (x100)\n", (int) ftGe_BlastDist[z], (int) (to * 100.0f));
+    }
+    if (x != fp->mv.ge.angle || lock) {
+        fp->mv.ge.angle = x;
+        if (!(fp->mv.ge.flags & GE_BLAST_NONE)) {
+            itGe_BlastMove(gobj, x, ftGe_BlastFloor(fp, x));
+        }
+    }
+}
+
+/* v1.5 (Michael, 2026-09-30: "stage 2 covers all three"): the second star marks all three places, 36, 50 and 64 ahead,
+ * whatever the stick: the one mark (locked, snapped to its place) and the other two */
+static void ftGe_BlastSides(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int z, k;
+    ftGe_BlastSteer(gobj, true, true);
+    if (fp->mv.ge.flags & GE_BLAST_NONE) {
+        return;
+    }
+    z = GE_BLAST_ZONE_OF(fp);
+    for (k = 0; k < 3; k++) {
+        if (k != z) {
+            ftGe_BlastColumn(gobj, fp->mv.ge.vx + fp->facing_dir * ftGe_BlastDist[k]);
+        }
+    }
+}
+
+static void ftGe_SpawnBlast(Fighter_GObj* gobj, int stars)
+{
+    /* v1.5: the release strikes the marks already shown (placed at the press, widened at star 2) */
+    Fighter* fp = GET_FIGHTER(gobj);
+    OSReport("GENO BLAST release arms the marks: stars %d frame %d\n", stars, (int) fp->cur_anim_frame);
+    if (fp->ground_or_air == GA_Air && fp->cur_pos.y < 0.0f) {
+        /* no Blast below ledge height (¬ß8 rule 2): a charge carried off the stage and falling below the ledge before it
+         * releases strikes nothing; its marks go */
+        OSReport("GENO BLAST refused at the release: below ledge height\n");
+        itGe_BlastClear(gobj);
+        return;
+    }
+    itGe_BlastArm(gobj);
+    if (efGe_Loaded()) { /* geno-fx: SMRPG's cast, blue sparkles rising at his hand (EfGeData.dat BLAST_CAST) */
+        Vec3 hand;
+        ftGe_MuzzlePos(gobj, &hand, GE_PART_RHAND, 0.0f, "blast cast");
+        efSync_Spawn(EFGE_BLAST_CAST, gobj, &hand);
+    }
+}
+#else
+static void ftGe_SpawnBlast(Fighter_GObj* gobj, int stars)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    f32 sx = fp->input.lstick[0].x * fp->facing_dir; /* forward is positive */
+    f32 d = sx > 0.3f ? GE_BLAST_FAR : sx < -0.3f ? GE_BLAST_NEAR : GE_BLAST_MID;
+    f32 x = fp->cur_pos.x + fp->facing_dir * d;
+    int live = itGe_CountOwned(gobj, It_Kind_Geno_Blast);
+    OSReport("GENO SPAWN blast stars %d frame %d dist %d live %d\n", stars, (int) fp->cur_anim_frame, (int) d, live);
+    if (live > 0) {
+        return; /* one set of marks at a time */
+    }
+    itGe_SpawnBlast(gobj, x, fp->cur_pos.y, fp->facing_dir);
+    if (stars >= 2) {
+        itGe_SpawnBlast(gobj, x - GE_BLAST_SPREAD, fp->cur_pos.y, fp->facing_dir);
+        itGe_SpawnBlast(gobj, x + GE_BLAST_SPREAD, fp->cur_pos.y, fp->facing_dir);
+    }
+}
+#endif
