diff --git a/src/melee/it/kinds/itgeno.c b/src/melee/it/kinds/itgeno.c
new file mode 100644
index 0000000..52d2b9b
--- /dev/null
+++ b/src/melee/it/kinds/itgeno.c
@@ -0,0 +1,1217 @@
+/* Geno's items (a new fighter kind; non-matching builds only): kinds after It_Kind_Kyasarin_Egg with their own
+ * article, logic and render tables, so no existing item shifts. Their articles come from PlGe.dat's article list
+ * (animation-pipeline projects/geno/rig/articles.py), registered by ftGe_Init_OnLoad. */
+#ifndef MUST_MATCH
+#include "itgeno.h"
+#include <melee/gm/gmvs.h>
+#include <dolphin/os.h>
+
+#include "itfoxlaser.h"
+#include <melee/it/itCharItems.h>
+#include <melee/it/inlines.h>
+#include "inlines.h"
+#include <melee/it/it_2725.h>
+#include <melee/it/itcoll.h>
+#include <melee/it/itgroundcoll.h>
+#include <melee/mp/forward.h>
+#include <melee/it/ithitbox.h>
+#include <melee/it/it_26B1.h>
+#include <melee/db/db.h>
+#include <melee/ft/ftlib.h>
+#include <melee/ft/inlines.h>
+#include <melee/ft/types.h>
+#include <melee/ft/kinds/ftCommon/forward.h>
+#include <melee/it/itdraw.h>
+#include <melee/it/item.h>
+#include <sysdolphin/baselib/gobj.h>
+#include <math.h>
+#include <sysdolphin/baselib/jobj.h>
+#include <melee/ef/efasync.h>
+#include <melee/ef/efsync.h>
+#include <melee/mp/mplib.h>
+#include <melee/ft/kinds/ftGeno/ftgeno_efge.h>
+#include <melee/ft/kinds/ftGeno/ftgeno.h>
+
+Article* itGe_Articles[ITGE_COUNT];
+
+struct sdata_ItemGXLink itGe_GXLink[ITGE_COUNT] = {
+    { it_8026EECC }, /* Finger Shot */
+    { it_8026EECC }, /* Geno Beam */
+    { it_8026EECC }, /* Geno Whirl */
+    { it_8026EECC }, /* Geno Blast */
+    { it_8026EECC }, /* Geno Flash */
+};
+
+/* ---- Geno Whirl (side B): the pressure piece he runs in behind (DESIGN v1.2 ¬ß5). Travel, easing from v0 to v1; on a
+ * shield it grinds (three hits, 13 frames apart, in the article's state script); after the travel or a grind it hovers,
+ * and after the outbound hit it spins down. No recall (v1.5, Michael, 2026-09-30: "the recall behavior for Whirl should
+ * be completely removed"): side B while it is out is only the timed-hit check (ftgeno_specials.c). The hitbox stays live
+ * from the travel into the hover, so each hits a given opponent once per throw (projects/geno/rig/articles.py). */
+typedef struct itGe_WhirlAttr {
+    f32 v0, v1;       /* speed at the start and the end of the travel */
+    f32 travel;       /* travel frames */
+    f32 hover;        /* hover frames */
+    f32 grind;        /* grind frames */
+    f32 bend;         /* the stick's bend, radians at full tilt */
+    f32 hover_dmg;    /* the hover's numbers, when the travel's hitbox carries into it */
+    f32 hover_angle;
+} itGe_WhirlAttr;
+
+#define GE_SFX_WHIRL_HIT 550018
+#define GE_SFX_WHIRL_CRIT 550020
+#define GE_SFX_BLAST_COLUMNS 550022
+#define GE_SFX_FLASH_EXPLOSION 550025
+#define GE_WHIRL_SPIN_FRAMES 20 /* after the outbound hit: no hitbox, then gone (Michael, v1.2) */
+/* On a shield (Michael, 2026-09-29: the grind carried it past the shielder). The disc still presses in at 0.4 a frame,
+ * as before, but only up to the shield's front: its centre stops BITE in front of the shield's near surface (its 3.6
+ * hitbox overlapping the shield, so the grind hits land as before), never through the shield and the shielder. A light
+ * shield's pushback still outruns it (Melee's own escape, and the same hits land as before). Each grind hit knocks it
+ * KICK back off the shield, and it presses in again; after the grind it backs off to CLEAR in front of the front, over
+ * SETTLE frames, and hovers there (it never moves forward in the hover). */
+#define GE_WHIRL_PRESS 0.4f
+#define GE_WHIRL_BITE 1.0f
+#define GE_WHIRL_KICK 1.5f
+#define GE_WHIRL_CLEAR 5.0f
+#define GE_WHIRL_SETTLE 12
+#define WV(ip) ((ip)->xDD4_itemVar.genowhirl)
+static void itGe_WhirlStop(Item_GObj* g);
+static void itGe_WhirlDisarm(Item_GObj* g);
+#define WA(ip) ((itGe_WhirlAttr*) (ip)->xC4_article_data->x4_specialAttributes)
+
+/* Into the hover without a state change: the travel's hitbox stays live (its victims can't be hit again) and drops to
+ * the hover's numbers. A state change would reset it, and the hover would hit the outbound's victim a second time. */
+static void itGe_WhirlStop(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    HitCapsule* hit = &ip->x5D4_hitboxes[0].hit;
+    WV(ip).phase = GE_WHIRL_HOVER;
+    WV(ip).t = 0;
+    if (hit->state != HitCapsule_Disabled) {
+        hit->kb_angle = (int) WA(ip)->hover_angle;
+        it_80272460(hit, (u32) (ip->xC3C * (WA(ip)->hover_dmg * ip->xC40)), g);
+    }
+}
+
+static void itGe_WhirlSet(Item_GObj* g, int phase)
+{
+    Item* ip = GET_ITEM(g);
+    OSReport("GENO WHIRL phase %d -> %d\n", WV(ip).phase, phase);
+    it_802725D4(g); /* the last phase's hitbox goes, and with it its victims */
+    WV(ip).phase = phase;
+    WV(ip).t = 0;
+    Item_80268E5C(g, phase, ITEM_ANIM_UPDATE);
+}
+
+/* DESIGN ¬ß8 rule 1: a ledge grab or a helpless fall despawns his Whirl and cancels any pending Blast (no planking
+ * with stage coverage, no recovering under cover). The items check their owner each frame. */
+static bool itGe_FighterForbids(HSD_GObj* owner)
+{
+    Fighter* fp;
+    if (owner == NULL || !ftLib_IsFighter(owner)) {
+        return false;
+    }
+    fp = GET_FIGHTER(owner);
+    return fp->motion_id == ftCo_MS_CliffCatch || fp->motion_id == ftCo_MS_CliffWait ||
+           fp->motion_id == ftCo_MS_FallSpecial || fp->motion_id == ftCo_MS_FallSpecialF ||
+           fp->motion_id == ftCo_MS_FallSpecialB;
+}
+
+static bool itGe_OwnerForbids(Item* ip)
+{
+    return itGe_FighterForbids(ip->owner);
+}
+
+/* geno-fx: the Whirl's look (projects/geno/fx/whirl_model.py, efge.py WHIRL_*): SMRPG's trail of fading ovals, dropped
+ * every few frames of the throw; the bursts on its hits; the disc shrinks away as it spins down after
+ * the outbound hit and at the end of its hover (its model's children: the tilted disc and its aura) */
+#define GE_WHIRL_RING_EVERY 3
+#define GE_WHIRL_FADE 8
+static void itGe_WhirlFx(Item_GObj* g, int gfx)
+{
+    if (efGe_Loaded()) {
+        efSync_Spawn(gfx, g, &GET_ITEM(g)->pos);
+    }
+}
+
+static void itGe_WhirlLook(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    itGe_WhirlAttr* a = WA(ip);
+    f32 k = 1.0f;
+    HSD_JObj* j;
+    if (WV(ip).phase == GE_WHIRL_TRAVEL && WV(ip).t % GE_WHIRL_RING_EVERY == 1) {
+        itGe_WhirlFx(g, EFGE_WHIRL_RING);
+    }
+    if (WV(ip).phase == GE_WHIRL_SPIN) {
+        k = 1.0f - (f32) WV(ip).t / GE_WHIRL_SPIN_FRAMES;
+    } else if (WV(ip).phase == GE_WHIRL_HOVER && WV(ip).t > a->hover - GE_WHIRL_FADE) {
+        k = (a->hover - WV(ip).t) / GE_WHIRL_FADE;
+    }
+    if (k < 0.05f) {
+        k = 0.05f;
+    }
+    for (j = HSD_JObjGetChild(GET_JOBJ(g)); j != NULL; j = HSD_JObjGetNext(j)) {
+        HSD_JObjSetScaleX(j, k);
+        HSD_JObjSetScaleY(j, k);
+        HSD_JObjSetScaleZ(j, k);
+    }
+}
+
+/* The fighter whose shield the disc just met: the nearest guarding opponent. */
+static HSD_GObj* itGe_WhirlShielder(Item* ip)
+{
+    HSD_GObj* g;
+    HSD_GObj* best = NULL;
+    f32 bd = 1e9f;
+    for (g = HSD_GObjPLinkHead[HSD_GOBJ_PLINK_FIGHTER]; g != NULL; g = g->next) {
+        Fighter* fp = GET_FIGHTER(g);
+        f32 d = fp->cur_pos.x - ip->pos.x;
+        if (g == ip->owner || fp->motion_id < ftCo_MS_GuardOn || fp->motion_id > ftCo_MS_GuardReflect) {
+            continue;
+        }
+        d = d < 0.0f ? -d : d;
+        if (d < bd) {
+            bd = d;
+            best = g;
+        }
+    }
+    return best;
+}
+
+/* The shielder's guard sphere: its centre and world radius (a unit sphere on the shield joint, the director's SHIELD). */
+static f32 itGe_ShieldSphere(Fighter* fp, Vec3* c)
+{
+    MtxPtr m = HSD_JObjGetMtxPtr(fp->parts[fp->ft_data->x8->x11].joint);
+    c->x = m[0][3];
+    c->y = m[1][3];
+    c->z = m[2][3];
+    return sqrtf(m[0][0] * m[0][0] + m[1][0] * m[1][0] + m[2][0] * m[2][0]);
+}
+
+/* Lab trace, after a shield contact: the disc against the shield, every frame (whirl_shield_lab) */
+static void itGe_WhirlTrace(Item* ip)
+{
+    Fighter* sp;
+    Vec3 c;
+    f32 r;
+    if (WV(ip).shielder == NULL) {
+        return;
+    }
+    sp = GET_FIGHTER(WV(ip).shielder);
+    r = itGe_ShieldSphere(sp, &c);
+    OSReport("GENO WHIRLPOS %d %d %.2f %.2f shield %d %.2f %.2f %.2f %.1f at %.2f geno %.2f\n", WV(ip).phase, WV(ip).t,
+             ip->pos.x, ip->pos.y, sp->motion_id, c.x, c.y, r, sp->shield_health, sp->cur_pos.x,
+             ip->owner != NULL && ftLib_IsFighter(ip->owner) ? GET_FIGHTER(ip->owner)->cur_pos.x : 0.0f);
+}
+
+/* The shield's near surface at the disc's height, updated while the shielder guards (else the last one stands). */
+static void itGe_WhirlFront(Item* ip)
+{
+    Fighter* sp;
+    Vec3 c;
+    f32 r, dy, h;
+    if (WV(ip).shielder == NULL) {
+        return;
+    }
+    sp = GET_FIGHTER(WV(ip).shielder);
+    if (sp->motion_id < ftCo_MS_GuardOn || sp->motion_id > ftCo_MS_GuardReflect) {
+        return;
+    }
+    r = itGe_ShieldSphere(sp, &c);
+    dy = ip->pos.y - c.y;
+    h = r * r - dy * dy;
+    WV(ip).front = c.x - ip->facing_dir * (h > 0.0f ? sqrtf(h) : 0.0f);
+}
+
+static bool itGe_Whirl_Anim(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    itGe_WhirlAttr* a = WA(ip);
+    itGe_WhirlLook(g);
+    itGe_WhirlTrace(ip);
+    if (itGe_FighterForbids(WV(ip).thrower)) { /* his rule, even once a reflect has made another its owner */
+        OSReport("GENO WHIRL despawn: owner on the ledge or helpless\n");
+        return true;
+    }
+    WV(ip).t++;
+    switch (WV(ip).phase) {
+    case GE_WHIRL_TRAVEL:
+        if (WV(ip).crit == 1 && --WV(ip).crit_t <= 0) { /* the window closed with no contact: voided for this throw */
+            itGe_WhirlDisarm(g);
+            WV(ip).crit = 2;
+            OSReport("GENO WHIRL crit voided\n");
+        }
+        if (WV(ip).t >= a->travel) {
+            itGe_WhirlStop(g);
+        }
+        break;
+    case GE_WHIRL_GRIND: {
+        /* the grind is driven here, not by a script (item scripts run on the item's animation clock): the live hitbox
+         * forgets its victims on these frames, so it hits the shield again (3% each; the first waits out the contact's
+         * hitlag and shieldstun, the rest are 13 apart: a gap of 5 or more after each, DESIGN ¬ß8 rule 4) */
+        HitCapsule* hit = &ip->x5D4_hitboxes[0].hit;
+        if ((WV(ip).t == 15 || WV(ip).t == 28 || WV(ip).t == 41) && hit->state != HitCapsule_Disabled) {
+            it_8026FCF8(ip, hit);
+            itGe_WhirlFx(g, EFGE_WHIRL_GRIND);
+            OSReport("GENO WHIRL grind hit %d\n", WV(ip).t);
+        }
+        if (WV(ip).t >= a->grind) {
+            itGe_WhirlStop(g);
+        }
+        break;
+    }
+    case GE_WHIRL_HOVER:
+        if (WV(ip).t >= a->hover) {
+            return true; /* gone */
+        }
+        break;
+    case GE_WHIRL_SPIN:
+        if (WV(ip).t >= GE_WHIRL_SPIN_FRAMES) {
+            return true; /* spun down: side B is free again */
+        }
+        break;
+    }
+    return false;
+}
+
+static void itGe_Whirl_Phys(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    itGe_WhirlAttr* a = WA(ip);
+    switch (WV(ip).phase) {
+    case GE_WHIRL_TRAVEL: {
+        f32 u = WV(ip).t / a->travel;
+        f32 v = a->v0 + (a->v1 - a->v0) * (u > 1.0f ? 1.0f : u);
+        ip->x40_vel.x = ip->facing_dir * v * cosf(WV(ip).angle);
+        ip->x40_vel.y = v * sinf(WV(ip).angle);
+        break;
+    }
+    case GE_WHIRL_GRIND: { /* it presses into the shield up to its front, never through it */
+        f32 v; /* along the throw */
+        itGe_WhirlFront(ip);
+        v = ((WV(ip).front - ip->pos.x) * ip->facing_dir - GE_WHIRL_BITE - WV(ip).kick) * 0.5f;
+        WV(ip).kick *= 0.7f;
+        v = v > GE_WHIRL_PRESS ? GE_WHIRL_PRESS : v < -3.0f ? -3.0f : v;
+        ip->x40_vel.x = ip->facing_dir * v;
+        ip->x40_vel.y = 0.0f;
+        break;
+    }
+    default: /* the hover holds still; after a grind it first backs off the shield's front and settles there */
+        ip->x40_vel.x = ip->x40_vel.y = 0.0f;
+        if (WV(ip).phase == GE_WHIRL_HOVER && WV(ip).shielder != NULL && WV(ip).t <= GE_WHIRL_SETTLE) {
+            f32 v = ((WV(ip).front - ip->pos.x) * ip->facing_dir - GE_WHIRL_CLEAR) * 0.3f; /* along the throw */
+            ip->x40_vel.x = ip->facing_dir * (v > 0.0f ? 0.0f : v);
+        }
+        break;
+    }
+    ip->x40_vel.z = 0.0f;
+}
+
+static bool itGe_Whirl_Coll(Item_GObj* g)
+{
+    /* the ground lane (DESIGN ¬ß5): a down-bent throw that meets the floor levels out and rolls along it. Other throws
+     * ignore terrain, so they cross platforms */
+    Item* ip = GET_ITEM(g);
+    if (WV(ip).phase == GE_WHIRL_TRAVEL && (WV(ip).angle < 0.0f || WV(ip).rolling)) {
+        bool floor;
+        it_8026D9A0(g);
+        floor = (ip->x378_itemColl.env_flags & Collide_FloorMask) != 0; /* its return value doesn't report the floor */
+        if (floor) {
+            if (!WV(ip).rolling) {
+                OSReport("GENO WHIRL rolls\n");
+            }
+            WV(ip).angle = 0.0f;
+            WV(ip).rolling = 1;
+        }
+    }
+    return false;
+}
+
+static ItemStateTable itGe_WhirlStates[] = {
+    { 0, itGe_Whirl_Anim, itGe_Whirl_Phys, itGe_Whirl_Coll },
+    { 1, itGe_Whirl_Anim, itGe_Whirl_Phys, itGe_Whirl_Coll },
+    { 2, itGe_Whirl_Anim, itGe_Whirl_Phys, itGe_Whirl_Coll },
+};
