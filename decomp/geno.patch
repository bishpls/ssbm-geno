+            fp->accessory4_cb = ftGe_FlashCb;
+        } else {
+            ftGe_BlastRelease(gobj); /* no Flash in the air: the widened Blast releases itself */
+        }
+        return;
+    }
+    if (!held && f + 1 >= BLAST_MARK_FRAME) {
+        ftGe_BlastRelease(gobj);
+        return;
+    }
+    if (fp->ground_or_air == GA_Air) { /* never reached: every charge leaves by the third star */
