+
+/* The Geno Beam's numbers and spawns, shared with Kirby's copy of it (ftKirby/ftkirbyspecialgeno.c) */
+typedef struct ftGe_BeamTuning {
+    int star_frames;         /* a star every this many frames of charge, counted from the press */
+    int grace;               /* frames past the third star before it fires itself */
+    int tap;                 /* releasing B before this frame from the press is a tap: Finger Shot (v1.5: 20) */
+    int store_decay;         /* unused since v1.4 (no store) */
+    int start_frames;        /* the start's length (SpecialNStart) */
+    int fire_frame;          /* the release spawns the Beam on this frame (SpecialNEnd) ... */
+    int end_frames;          /* ... and is this long */
+    int finger_fire;         /* Finger Shot on the ground: the shot's frame and the length (SpecialNFinger) */
+    int finger_frames;
+    int air_finger_fire;     /* and in the air (SpecialAirNFinger) */
+    int air_finger_frames;
+    float air_end_lag;       /* landing lag: during the aerial release ... */
+    float air_finger_lag;    /* ... and during an aerial Finger Shot before air_finger_lag_until */
+    int air_finger_lag_until;
+    int sfx_charge;          /* Geno's sounds (bank 55) */
+    int sfx_star1;           /* +1, +2: the second and third stars */
+    int sfx_store;
+    int sfx_finger;
+} ftGe_BeamTuning;
