+#ifndef MUST_MATCH /* animation-pipeline: Geno's ledge catch is continuous */
+/* The engine places a ledge catch at the ledge plus CliffCatch's TransN path from its first frame, wherever the ledge-grab box
+ * found the fighter (anywhere from beside the ledge to ~15 units out, 10-13 below it), so a catch jumps. For Geno the
+ * difference is kept and eased out over CliffCatch (smoothstep over its animation), so he swings from where he was into his
+ * hang: the path still ends on his hang, which CliffWait and every ledge action start from. */
+#include <dolphin/os.h>
+#define FTGE_CATCH_EASE 6.0F /* frames: CliffCatch is 8, so its last frames sit on the path and CliffWait meets it exactly */
+
+static float ftGe_CatchBlend(Fighter* fp)
+{
+    float u = fp->cur_anim_frame / FTGE_CATCH_EASE;
+    if (u >= 1.0F) {
+        return 0.0F;
+    }
+    if (u < 0.0F) {
+        u = 0.0F;
+    }
+    return 1.0F - u * u * (3.0F - 2.0F * u);
+}
+#endif
