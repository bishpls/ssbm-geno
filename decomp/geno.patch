+/* ---- Geno Flash (down B's third star): a sun that grows, lingers, and is gone; one strong hit per target. The hitbox's
+ * radius grows in code (a script sets it once); the model is Geno's own sun (geno-fx; the donor is Ness's PK Flash). */
+typedef struct itGe_FlashAttr {
+    f32 grow, linger; /* frames */
+    f32 r0, r1;       /* radius at the start and at full size */
+    f32 ahead, high;  /* where the sun sits, from him */
+    /* animation-pipeline (Michael, 2026-09-29): a sweetspot then a sourspot in time. The script's hitbox is the burst,
+     * the kill hit, for its first `burst` frames; then the same hitbox (so whoever it hit stays hit: one hit per target
+     * for the whole sun) turns into the lingering sun's weaker hit */
+    f32 burst;
+    f32 late_dmg, late_angle, late_kbg, late_bkb;
+} itGe_FlashAttr;
+
+#define FV(ip) ((ip)->xDD4_itemVar.genoflash)
+#define FA(ip) ((itGe_FlashAttr*) (ip)->xC4_article_data->x4_specialAttributes)
+
+/* geno-fx: the Flash's look (projects/geno/fx/flash_model.py, efge.py FLASH_*): one sun for the whole move (Michael,
+ * 2026-09-29), the fireball in flight being the same sun, small. Its disc (with a small surprised face) has its edge at
+ * GE_FLASH_FIT of the hitbox's radius; only the corona, two layers of flame tongues turning opposite ways (the state's
+ * animation), reaches past it, flickering in scale here; a haze behind. The model's joints (haze, corona B, corona A,
+ * disc) face the camera and are sized in disc radii; a donor model (no children) is left alone */
+#define GE_FLASH_FIT 0.98f
+static void itGe_FlashScale(HSD_JObj* j, f32 s)
+{
+    HSD_JObjSetScaleX(j, s);
+    HSD_JObjSetScaleY(j, s);
+    HSD_JObjSetScaleZ(j, s);
+}
+
+static void itGe_FlashLook(Item_GObj* g, f32 t, f32 r)
+{
+    HSD_JObj* haze = HSD_JObjGetChild(GET_JOBJ(g));
+    HSD_JObj* cb = haze != NULL ? HSD_JObjGetNext(haze) : NULL;
+    HSD_JObj* ca = cb != NULL ? HSD_JObjGetNext(cb) : NULL;
+    HSD_JObj* disc = ca != NULL ? HSD_JObjGetNext(ca) : NULL;
+    f32 d = GE_FLASH_FIT * r;
+    if (disc == NULL) {
+        return;
+    }
+    itGe_FlashScale(haze, d * (1.0f + 0.03f * sinf(0.29f * t)));
+    itGe_FlashScale(cb, d * (1.0f + 0.03f * sinf(0.47f * t + 2.0f) + 0.02f * sinf(1.37f * t + 0.3f)));
+    itGe_FlashScale(ca, d * (1.0f + 0.03f * sinf(0.61f * t) + 0.02f * sinf(1.73f * t + 1.1f)));
+    itGe_FlashScale(disc, d);
+}
+
+static bool itGe_Flash_Anim(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    itGe_FlashAttr* a = FA(ip);
+    HitCapsule* hit = &ip->x5D4_hitboxes[0].hit;
+    f32 u;
+    FV(ip).t++;
+    u = FV(ip).t / a->grow;
+    if (u > 1.0f) {
+        u = 1.0f;
+    }
+    if (hit->state != HitCapsule_Disabled) {
+        if (FV(ip).t == (int) a->burst) {
+            it_80272460(hit, ip->xC3C * (a->late_dmg * ip->xC40), g);
+            hit->kb_angle = (int) a->late_angle;
+            hit->x24 = (u32) a->late_kbg;
+            hit->x2C = (u32) a->late_bkb;
+            OSReport("GENO FLASH late hit from t %d\n", FV(ip).t);
+        }
+        hit->scale = a->r0 + (a->r1 - a->r0) * u;
+        it_80275594(g, 0, 1.0f / ip->scl);
+    }
+    itGe_FlashLook(g, (f32) FV(ip).t, a->r0 + (a->r1 - a->r0) * u);
+    if (FV(ip).t >= a->grow + a->linger) {
+        if (efGe_Loaded()) {
+            efSync_Spawn(EFGE_FLASH_END, g, &ip->pos);    /* the sun's silhouette flashing red */
+            efSync_Spawn(EFGE_FLASH_FINISH, g, &ip->pos); /* over it the finishing flash: a spinning star, a ring, stars */
+        }
+        return true;
+    }
+    return false;
+}
+
+static void itGe_Flash_Phys(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    ip->x40_vel.x = ip->x40_vel.y = ip->x40_vel.z = 0.0f;
+}
+
+static ItemStateTable itGe_FlashStates[] = {
+    { 0, itGe_Flash_Anim, itGe_Flash_Phys, itGe_Blast_Coll },
+};
+
+HSD_GObj* itGe_SpawnFlash(HSD_GObj* owner, Vec3* at, f32 facing)
+{
+    SpawnItem spawn;
+    Item_GObj* g;
+    Item* ip;
+    spawn.kind = It_Kind_Geno_Flash;
+    Item_InitSpawnPositionFromParent(&spawn, owner, at);
+    Item_InitSpawnCommonFields(&spawn, owner, facing, true);
+    g = Item_80268B18(&spawn);
+    if (g == NULL) {
+        return NULL;
+    }
+    ip = GET_ITEM(g);
+    FV(ip).t = 0;
+    ip->pos = *at;
+    Item_80268E5C(g, 0, ITEM_ANIM_UPDATE);
+    Item_8026AE84(ip, GE_SFX_FLASH_EXPLOSION, 0x40, 0x7F);
+    if (efGe_Loaded()) {
+        efSync_Spawn(EFGE_FLASH_BURST, g, &ip->pos); /* geno-fx: the burst's white heat, over its sweetspot frames */
+    }
+    db_80225DD8(g, owner);
+    return g;
+}
+
+void itGe_BlastArm(HSD_GObj* owner)
+{
+    HSD_GObj* g;
+    int n = 0;
+    for (g = HSD_GObjPLinkHead[HSD_GOBJ_PLINK_ITEM]; g != NULL; g = g->next) {
+        Item* ip = GET_ITEM(g);
+        if (ip->kind == It_Kind_Geno_Blast && ip->owner == owner && BV(ip).armed == 0) {
+            BV(ip).armed = 1;
+            BV(ip).t = 0;
+            n++;
+        }
+    }
+    OSReport("GENO BLAST armed %d\n", n);
+}
+
+void itGe_BlastClear(HSD_GObj* owner)
+{
+    HSD_GObj* g;
+    for (g = HSD_GObjPLinkHead[HSD_GOBJ_PLINK_ITEM]; g != NULL; g = g->next) {
+        Item* ip = GET_ITEM(g);
+        if (ip->kind == It_Kind_Geno_Blast && ip->owner == owner && BV(ip).armed == 0) {
+            BV(ip).armed = -1;
+        }
+    }
+}
+
+/* v1.5, the forgiving mark (Michael, 2026-09-30): the shown mark slides where the stick puts it until the second star
+ * or the release. The item is moved, not respawned, so its tell keeps animating; its floor parts follow where it now
+ * stands (the floor oval and the column's foot on a floor, the void tail over the void; itGe_BlastColour's rule). */
+void itGe_BlastMove(HSD_GObj* owner, f32 x, f32 floor_y)
+{
+    HSD_GObj* g;
+    for (g = HSD_GObjPLinkHead[HSD_GOBJ_PLINK_ITEM]; g != NULL; g = g->next) {
+        Item* ip = GET_ITEM(g);
+        if (ip->kind == It_Kind_Geno_Blast && ip->owner == owner && BV(ip).armed == 0 && BV(ip).phase == GE_BLAST_MARK) {
+            HSD_JObj* mark = HSD_JObjGetChild(GET_JOBJ(g));
+            HSD_JObj* grp = mark != NULL ? HSD_JObjGetNext(mark) : NULL;
+            HSD_JObj* c;
+            int k = 0;
+            bool onfloor;
+            ip->pos.x = x;
+            ip->pos.y = floor_y + BA(ip)->lift;
+            BV(ip).floor_y = floor_y;
+            onfloor = itGe_BlastOnFloor(ip);
+            if (grp != NULL) {
+                if (HSD_JObjGetChild(mark) != NULL) {
+                    if (onfloor) {
+                        HSD_JObjClearFlags(HSD_JObjGetChild(mark), JOBJ_HIDDEN);
+                    } else {
+                        HSD_JObjSetFlags(HSD_JObjGetChild(mark), JOBJ_HIDDEN);
+                    }
+                }
+                for (c = HSD_JObjGetChild(grp); c != NULL; c = HSD_JObjGetNext(c), k++) {
+                    HSD_JObj* foot = HSD_JObjGetChild(c);
+                    HSD_JObj* tail = foot != NULL ? HSD_JObjGetNext(foot) : NULL;
+                    if (k == BV(ip).colour && foot != NULL && tail != NULL) {
+                        HSD_JObjClearFlags(onfloor ? foot : tail, JOBJ_HIDDEN);
+                        HSD_JObjSetFlags(onfloor ? tail : foot, JOBJ_HIDDEN);
+                    }
+                }
+            }
+            OSReport("GENO BLAST mark moved x %d floor %d on the floor %d (x100)\n", (int) (x * 100.0f),
+                     (int) (floor_y * 100.0f), onfloor);
+        }
+    }
+}
+
+/* The second star: two more columns either side of the pending mark, on its clock, so all three strike together. */
+void itGe_BlastWiden(HSD_GObj* owner, f32 spread)
+{
+    HSD_GObj* g;
+    for (g = HSD_GObjPLinkHead[HSD_GOBJ_PLINK_ITEM]; g != NULL; g = g->next) {
+        Item* ip = GET_ITEM(g);
+        if (ip->kind == It_Kind_Geno_Blast && ip->owner == owner && BV(ip).phase == GE_BLAST_MARK) {
+            f32 x = ip->pos.x, y = BV(ip).floor_y, face = ip->facing_dir;
+            int t = BV(ip).t, k;
+            for (k = -1; k <= 1; k += 2) {
+                HSD_GObj* side = itGe_SpawnBlast(owner, x + k * spread, y, face);
+                if (side != NULL) {
+                    BV(GET_ITEM(side)).t = t;
+                }
+            }
+            return;
+        }
+    }
+}
+
+/* geno-fx: the Finger Shot's own model (projects/geno/fx/finger_model.py): four bullets, each a child joint of the root on
+ * one of the laser's hitbox spheres, so they string out with them as the laser grows its root along Z; the bullets
+ * themselves take the inverse growth, so a head keeps its shape instead of being squashed flat for the first frames. A
+ * donor model (no children) is the laser's own. */
+static bool itGe_Finger_Anim(Item_GObj* g)
+{
+    bool r = itFoxlaser_UnkMotion1_Anim(g);
+    HSD_JObj* b = HSD_JObjGetChild(GET_JOBJ(g));
+    f32 s = GET_ITEM(g)->xDD4_itemVar.foxlaser.scale;
+    f32 inv = s > 0.02f ? 1.0f / s : 50.0f;
+    for (; b != NULL; b = HSD_JObjGetNext(b)) {
+        HSD_JObjSetScaleZ(b, inv);
+    }
+    return r;
+}
+
+static ItemStateTable itGe_FingerStates[] = {
+    { 0, itGe_Finger_Anim, itFoxlaser_UnkMotion1_Phys, itFoxlaser_UnkMotion1_Coll },
+    { 1, itGe_Finger_Anim, itFoxlaser_UnkMotion1_Phys, itFoxlaser_UnkMotion1_Coll }, /* the down throw's shots */
+};
+
+struct ItemLogicTable itGe_Logic[ITGE_COUNT] = {
+    {
+        /* Finger Shot: a laser (Falco's article), so the laser's own code drives it: straight flight, reflect,
+         * absorb, shield bounce, gone on hit */
+        itGe_FingerStates,
+        NULL, NULL, NULL, NULL, NULL,
+        itFoxLaser_Logic94_Clanked, /* damage dealt: gone */
+        NULL, NULL,
+        itFoxLaser_Logic94_Reflected,
+        itFoxLaser_Logic94_Clanked,
+        itFoxLaser_Logic94_Absorbed,
+        itFoxLaser_Logic94_ShieldBounced,
+        itFoxLaser_Logic94_HitShield,
+        itFoxLaser_Logic94_EvtUnk,
+    },
+    {
+        /* Geno Beam: the same laser behaviour, at the level's state */
+        itGe_BeamStates,
+        NULL, NULL, NULL, NULL, NULL,
+        itFoxLaser_Logic94_Clanked,
+        NULL, NULL,
+        itGe_Beam_Reflected,
+        itFoxLaser_Logic94_Clanked,
+        itFoxLaser_Logic94_Absorbed,
+        itFoxLaser_Logic94_ShieldBounced,
+        itFoxLaser_Logic94_HitShield,
+        itFoxLaser_Logic94_EvtUnk,
+    },
+    {
+        /* Geno Whirl */
+        itGe_WhirlStates,
+        NULL,
+        itGe_Whirl_Destroyed,
+        NULL, NULL, NULL,
+        itGe_Whirl_DmgDealt,
+        itGe_Whirl_DmgReceived,
+        NULL,
+        itGe_Whirl_Reflected, /* reflected: the disc turns on its thrower, as reflected items do */
+        itGe_Whirl_Clanked,   /* clanked: breaks on 6% or more, survives (cancelling) less */
+        itGe_Whirl_Gone,      /* absorbed */
+        itGe_Whirl_Keep,      /* shield bounced: no, it grinds */
+        itGe_Whirl_HitShield,
+        itGe_Whirl_EvtUnk,
+    },
+    {
+        /* Geno Blast: nothing stops the column but an absorber */
+        itGe_BlastStates,
+        NULL, NULL, NULL, NULL, NULL,
+        itGe_Whirl_Keep, /* damage dealt: it goes on (one hit group: a target is hit once) */
+        NULL, NULL,
+        itGe_Whirl_Keep, /* reflected: a column from above isn't turned */
+        itGe_Whirl_Keep, /* clanked */
+        itGe_Whirl_Gone, /* absorbed */
+        itGe_Whirl_Keep, /* shield bounced */
+        itGe_Whirl_Keep, /* hit a shield */
+        itGe_Whirl_EvtUnk,
+    },
+    {
+        /* Geno Flash: the same, a sun nothing stops but an absorber */
+        itGe_FlashStates,
+        NULL, NULL, NULL, NULL, NULL,
+        itGe_Whirl_Keep,
+        NULL, NULL,
+        itGe_Whirl_Keep,
+        itGe_Whirl_Keep,
+        itGe_Whirl_Gone,
+        itGe_Whirl_Keep,
+        itGe_Whirl_Keep,
+        itGe_Whirl_EvtUnk,
+    },
+};
+
+void itGe_SetArticle(Article* article, int kind)
+{
+    itGe_Articles[kind - It_Kind_Geno_Start] = article;
+}
+
+/* How many of this owner's items of a kind are live (Finger Shot caps at two on screen). */
+int itGe_CountOwned(HSD_GObj* owner, int kind)
+{
+    int n = 0;
+    HSD_GObj* g;
+    for (g = HSD_GObjPLinkHead[HSD_GOBJ_PLINK_ITEM]; g != NULL; g = g->next) {
+        Item* ip = GET_ITEM(g);
+        if (ip->kind == kind && ip->owner == owner) {
+            n++;
+        }
+    }
+    return n;
+}
+
+/* Finger Shot: a straight shot from the hand at `speed` units a frame along `angle` (state 0 of the article). */
+void itGe_SpawnFinger(HSD_GObj* owner, Vec3* pos, f32 angle, f32 speed)
+{
+    it_8029C504(owner, pos, 0, It_Kind_Geno_Finger, angle, speed);
+}
+
+/* Geno Beam: one to three stars pick the article's state 0-2 (damage, size, knockback). */
+HSD_GObj* itGe_SpawnWhirl(HSD_GObj* owner, Vec3* pos, f32 facing, f32 bend)
+{
+    SpawnItem spawn;
+    Item_GObj* g;
+    Item* ip;
+    spawn.kind = It_Kind_Geno_Whirl;
+    Item_InitSpawnPositionFromParent(&spawn, owner, pos);
+    Item_InitSpawnCommonFields(&spawn, owner, facing, true);
+    g = Item_80268B18(&spawn);
+    if (g == NULL) {
+        return NULL;
+    }
+    ip = GET_ITEM(g);
+    WV(ip).angle = bend * WA(ip)->bend;
+    OSReport("GENO WHIRL angle %d (bend %d%%)\n", (int) (WV(ip).angle * 57.3f), (int) (bend * 100));
+    WV(ip).crit = 0;
+    WV(ip).rolling = 0;
+    WV(ip).shielder = NULL;
+    WV(ip).thrower = owner;
+    WV(ip).kick = 0.0f;
+    WV(ip).front = 0.0f;
+    itGe_WhirlSet(g, GE_WHIRL_TRAVEL);
+    db_80225DD8(g, owner);
+    return g;
+}
+
+/* The timed hit (DESIGN ¬ß5): side B again while it travels arms a 4-frame window for the outbound hit. An early press
+ * whose window closes without contact voids it for this throw, so mashing doesn't work. v1.5 (Michael, 2026-09-30:
+ * "no payoff to going for the timed hit"): the timed hit does more damage and pops the target up, a small vertical
+ * launcher to follow up from, instead of the plain hit's x1.35 growth. (On a monster the crit is 9999: the trailer's.) */
+#define GE_WHIRL_CRIT_WINDOW 4
+#define GE_WHIRL_TIMED_DMG 10     /* the plain hit's 7 */
+#define GE_WHIRL_TIMED_ANGLE 85   /* up, a touch forward (the plain hit's 40) */
+#define GE_WHIRL_TIMED_KBG 40
+#define GE_WHIRL_TIMED_BKB 80
+void itGe_WhirlArmCrit(HSD_GObj* whirl)
+{
+    Item* ip = GET_ITEM(whirl);
+    HitCapsule* hit = &ip->x5D4_hitboxes[0].hit;
+    if (ip->owner != WV(ip).thrower) {
+        OSReport("GENO WHIRL press ignored (reflected)\n"); /* a reflected disc is no longer his to time */
+        return;
+    }
+    if (WV(ip).phase != GE_WHIRL_TRAVEL || WV(ip).crit != 0 || hit->state == HitCapsule_Disabled) {
+        return;
+    }
+    WV(ip).crit = 1;
+    WV(ip).crit_t = GE_WHIRL_CRIT_WINDOW;
+    WV(ip).kbg = hit->x24;
+    WV(ip).bkb0 = hit->x2C;
+    WV(ip).angle0 = hit->kb_angle;
+    WV(ip).dmg0 = (int) hit->damage;
+    hit->x24 = GE_WHIRL_TIMED_KBG;
+    hit->x2C = GE_WHIRL_TIMED_BKB;
+    hit->kb_angle = GE_WHIRL_TIMED_ANGLE;
+    it_80272460(hit, (u32) (ip->xC3C * (GE_WHIRL_TIMED_DMG * ip->xC40)), whirl);
+    OSReport("GENO WHIRL crit armed\n");
+}
+
+/* the window closed with no contact: the travel hit's own numbers again */
+static void itGe_WhirlDisarm(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    HitCapsule* hit = &ip->x5D4_hitboxes[0].hit;
+    hit->x24 = WV(ip).kbg;
+    hit->x2C = WV(ip).bkb0;
+    hit->kb_angle = WV(ip).angle0;
+    it_80272460(hit, (u32) (ip->xC3C * (WV(ip).dmg0 * ip->xC40)), g);
+}
+
+/* Is this pointer a live Whirl of this owner's? (A stale pointer must never be dereferenced.) */
+bool itGe_IsLiveWhirl(HSD_GObj* owner, HSD_GObj* whirl)
+{
+    HSD_GObj* g;
+    if (whirl == NULL) {
+        return false;
+    }
+    for (g = HSD_GObjPLinkHead[HSD_GOBJ_PLINK_ITEM]; g != NULL; g = g->next) {
+        if (g == whirl) {
+            Item* ip = GET_ITEM(g);
+            return ip->kind == It_Kind_Geno_Whirl && WV(ip).thrower == owner; /* reflected or not: one on screen */
+        }
+    }
+    return false;
+}
+
+int itGe_WhirlPhase(HSD_GObj* whirl)
+{
+    return WV(GET_ITEM(whirl)).phase;
+}
+
+void itGe_SpawnBeam(HSD_GObj* owner, Vec3* pos, f32 facing, int stars, f32 speed)
+{
+    itGe_SpawnBeamTimed(owner, pos, facing, stars, speed, 0);
+}
+
+/* it_8029C504 (the laser's spawn), keeping the item: a timed Beam is marked for its boost */
+void itGe_SpawnBeamTimed(HSD_GObj* owner, Vec3* pos, f32 facing, int stars, f32 speed, int timed)
+{
+    SpawnItem spawn;
+    Item_GObj* g;
+    f32 angle = facing > 0 ? 0.0f : (f32) M_PI;
+    if (stars < 1) {
+        stars = 1;
+    }
+    if (stars > 3) {
+        stars = 3;
+    }
+    spawn.kind = It_Kind_Geno_Beam;
+    Item_InitSpawnPositionFromParent(&spawn, owner, pos);
+    Item_InitSpawnCommonFields(&spawn, owner, facing > 0 ? +1.0F : -1.0F, true);
+    g = Item_80268B18(&spawn);
+    if (g != NULL) {
+        Item* ip = GET_ITEM(g);
+        FoxLaserAttr* attr = ip->xC4_article_data->x4_specialAttributes;
+        Item_80268E5C(g, stars - 1, ITEM_ANIM_UPDATE);
+        it_80275158(g, attr->lifetime);
+        BMV(ip).laser.scale = 0.0F;
+        BMV(ip).laser.angle = angle;
+        BMV(ip).laser.speed = speed;
+        BMV(ip).laser.pos = spawn.pos;
+        BMV(ip).timed = timed ? 1 : 0;
+        BMV(ip).level = stars >= 3 ? 1.0f : stars == 2 ? 0.76f : 0.58f; /* the hitboxes' radii 3.8, 2.9, 2.2 */
+        BMV(ip).vis = stars >= 3 ? 1.0f : stars == 2 ? 0.70f : 0.45f;    /* drawn: clearly stepped (fx/beam_model.py) */
+        db_80225DD8(g, owner);
+    }
+}
+
+#endif
