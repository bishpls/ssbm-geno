+/* The Beam's levels: the laser's own motion, one state per star count (the article's states 0-2). A timed release's
+ * Beam (itGe_SpawnBeamTimed) takes +10% damage on the frame its state script has opened its hitboxes: the script sets
+ * each hitbox's damage from its own numbers when it runs, so the boost goes onto the live hitboxes, as the Whirl's crit
+ * does (itGe_WhirlArmCrit). */
+#define GE_BEAM_TIMED_DAMAGE 1.1f
+#define BMV(ip) ((ip)->xDD4_itemVar.genobeam)
+
+/* geno-fx: the Beam's own model (projects/geno/fx/beam_model.py): the root turns along the flight like the laser's, but
+ * only its first child (the trail: the core and glow shells) stretches as the bolt leaves the barrel, and the head (the
+ * flare, spun by its state's joint animation) keeps its shape; both take the level's size. The hitboxes ride the trail
+ * (bone 1), so they spread with the drawn beam and none sits behind the barrel at the spawn. A donor model (one
+ * joint, Falco's laser) falls back to the laser's own stretch. */
+static bool itGe_BeamRay(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    FoxLaserAttr* attr = ip->xC4_article_data->x4_specialAttributes;
+    HSD_JObj* root = GET_JOBJ(g);
+    HSD_JObj* trail = HSD_JObjGetChild(root);
+    HSD_JObj* head;
+    f32 lv = BMV(ip).level > 0.0f ? BMV(ip).level : 1.0f;
+    f32 vis = BMV(ip).vis > 0.0f ? BMV(ip).vis : lv;
+    f32 vx;
+    if (trail == NULL) {
+        return itFoxlaser_UnkMotion1_Anim(g);
+    }
+    ip->x40_vel.x = BMV(ip).laser.speed * cosf(BMV(ip).laser.angle);
+    ip->x40_vel.y = BMV(ip).laser.speed * sinf(BMV(ip).laser.angle);
+    ip->x40_vel.z = 0.0F;
+    ip->facing_dir = ip->x40_vel.x > 0.0F ? +1.0F : -1.0F;
+    HSD_JObjSetRotationY(root, M_PI_2 * ip->facing_dir);
+    vx = ip->facing_dir == 1.0F ? -ip->x40_vel.x : ip->x40_vel.x;
+    HSD_JObjSetRotationX(root, M_PI + atan2f(ip->x40_vel.y, vx));
+    BMV(ip).laser.scale += ABS(BMV(ip).laser.speed) / 11.25F;
+    if (BMV(ip).laser.scale > attr->scale) {
+        BMV(ip).laser.scale = attr->scale;
+    }
+    if (BMV(ip).laser.scale < 1e-5F) {
+        BMV(ip).laser.scale = 1e-3F;
+    }
+    /* the trail's cross-section is the drawn thickness (vis: the level cue, Michael 2026-09-29); its length is the
+     * hitboxes' spacing (they sit on its axis, so the cross-section doesn't move them) */
+    HSD_JObjSetScaleX(trail, vis);
+    HSD_JObjSetScaleY(trail, vis);
+    HSD_JObjSetScaleZ(trail, BMV(ip).laser.scale * lv); /* the level's length too: the trail's hitboxes spread with it */
+    head = HSD_JObjGetNext(trail);
+    if (head != NULL) {
+        HSD_JObjSetScaleX(head, vis);
+        HSD_JObjSetScaleY(head, vis);
+        HSD_JObjSetScaleZ(head, vis);
+    }
+    return it_80273130(g);
+}
+
+static void itGe_BeamParts(Item_GObj* g, bool star);
+static bool itGe_Beam_Anim(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    itGe_BeamParts(g, false);
+    if (BMV(ip).timed == 1) {
+        int i, n = 0;
+        for (i = 0; i < 4; i++) {
+            HitCapsule* hit = &ip->x5D4_hitboxes[i].hit;
+            if (hit->state != HitCapsule_Disabled) {
+                hit->damage *= GE_BEAM_TIMED_DAMAGE;
+                n++;
+            }
+        }
+        if (n > 0) {
+            BMV(ip).timed = 2;
+            OSReport("GENO BEAM timed: %d hitboxes, damage %d (x10)\n", n, (int) (ip->x5D4_hitboxes[0].hit.damage * 10.0f));
+        }
+    }
+    return itGe_BeamRay(g);
+}
