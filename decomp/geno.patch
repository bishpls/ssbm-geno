+static ItemStateTable itGe_BlastStates[] = {
+    { 0, itGe_Blast_Anim, itGe_Blast_Phys, itGe_Blast_Coll },
+    { 1, itGe_Blast_Anim, itGe_Blast_Phys, itGe_Blast_Coll },
+};
