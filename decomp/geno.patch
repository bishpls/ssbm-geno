+#include <melee/ft/inlines.h>
+#include <melee/ft/kinds/ftCommon/ftCo_Escape.h>
+#include <melee/ft/kinds/ftCommon/ftCo_Fall.h>
+#include <melee/ft/kinds/ftCommon/ftCo_FallSpecial.h>
+#include <melee/ft/kinds/ftCommon/ftCo_Landing.h>
+#include <melee/ft/kinds/ftCommon/ftCo_Wait.h>
+#include <melee/ft/kinds/ftCommon/inlines.h>
+#include <melee/ft/types.h>
+#include <sysdolphin/baselib/controller.h>
+
+#define GE_PI 3.14159265f
+
+/* ---- tuning (DESIGN.md v1.1 ¬ß5; move to PlGe.dat's special attributes once they settle) */
+#define BEAM_STAR_FRAMES 20    /* a star every 20 frames of charge (v1.3: was 15) */
+#define BEAM_GRACE 4           /* past the third star: it fires itself just after the star's +-3 timed window */
+#ifdef MUST_MATCH
+#define BEAM_TAP 6             /* releasing B before this frame of the start is a tap: Finger Shot */
+#else
+#define BEAM_TAP 20            /* v1.5 (Michael, 2026-09-30): B let go before this frame from the press is a tap, the Finger
+                                * Shot, and the stars light BEAM_TAP + 20k (40, 60, 80); the charge sound starts here */
+#endif
+#define STARROAD_SPEED 2.8f    /* units a frame */
+#ifdef MUST_MATCH
+#define STARROAD_FRAMES 20               /* v1.3: 56 units (v1.2: 24 frames, 67): easier to aim, a shorter recovery */
+#else
+#define STARROAD_FRAMES 16               /* v1.5 (Michael, 2026-09-30: dropping to sweetspot took him too near the blast zone):
+                                          * 45 units (v1.3: 20 frames, 56) */
+#endif
+#define STARROAD_LEDGE_FROM 4            /* v1.3: the ledge catches from travel frame 4 (v1.2: 14, and it never looked) */
+#define STARROAD_WALL_SLIDE 0.5f         /* v1.3: into a wall rising or falling faster than this, he slides along it */
+#define BLAST_WIDEN_FRAME 24             /* v1.3 held down B: the second star (was 18) ... */
+#ifdef MUST_MATCH
+#define BLAST_FLASH_FRAME 48             /* ... and, grounded, Geno Flash at the third (was 36) */
+#else
+#define BLAST_FLASH_FRAME 60             /* ... and, grounded, Geno Flash at the third (v1.5, Michael: 48 locked in too early) */
+#endif
+#define STARROAD_FREEFALL_MOBILITY 0.6f
+#define STARROAD_LANDING_LAG 30.0f
+#define FOLD_FALL_ACCEL 0.04f
+#define FOLD_FALL_MAX 1.0f
+
+static MotionFlags const ftGe_MF_Special = Ft_MF_SkipModel | Ft_MF_SkipItemVis;
+static MotionFlags const ftGe_MF_Keep = Ft_MF_KeepFastFall | Ft_MF_KeepGfx | Ft_MF_KeepSfx | Ft_MF_UpdateCmd |
+                                        Ft_MF_SkipColAnim | Ft_MF_SkipModelPartVis | Ft_MF_SkipModelFlags;
+
+static bool ftGe_TakeFlag(Fighter* fp)
+{
+    if (fp->throw_flags_b0) {
+        fp->throw_flags_b0 = false;
+        return true;
+    }
+    return false;
+}
+
+static void ftGe_Change(Fighter_GObj* gobj, FtMotionId ms)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    fp->throw_flags = 0;
+    fp->cmd_vars[0] = 0;
+    Fighter_ChangeMotionState(gobj, ms, Ft_MF_None, 0.0f, 1.0f, 0.0f, NULL);
+    ftAnim_8006EBA4(gobj);
+}
+
+#ifndef MUST_MATCH
+/* animation-pipeline (geno-atk-air): his look outlives a special's ground/air switch. The switch keeps the animation and
+ * skips the new action's commands up to its frame (Ft_MF_UpdateCmd), but an action change still reverts every visibility
+ * group (the weapon forms) and every part pose (the hands, the cap), so the Beam barrel or the Hand Cannons vanished
+ * mid-move when he walked off a ledge or landed. Save them before the change and put them back after. */
+typedef struct ftGe_Look {
+    s8 groups[12];
+    s8 poses[5];
+} ftGe_Look;
+
+static void ftGe_SaveLook(Fighter* fp, ftGe_Look* look)
+{
+    int i;
+    for (i = 0; i < 12; i++) {
+        look->groups[i] = i < (int) fp->x5AC.model_num ? fp->x5F4_arr[i].idx : -1;
+    }
+    for (i = 0; i < 5; i++) {
+        look->poses[i] = fp->x8B0[i].x11;
+    }
+}
+
+static void ftGe_RestoreLook(Fighter_GObj* gobj, ftGe_Look* look)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int i;
+    for (i = 0; i < 12 && i < (int) fp->x5AC.model_num; i++) {
+        if (fp->x5F4_arr[i].idx != look->groups[i]) {
+            ftParts_80074B0C(gobj, i, look->groups[i]);
+        }
+    }
+    for (i = 0; i < 5; i++) {
+        if (look->poses[i] != -1 && fp->x8B0[i].x11 != look->poses[i]) {
+            ftAnim_ApplyPartAnim(gobj, i, look->poses[i], 0.0f);
+        }
+    }
+}
+#endif
+
+/* ground <-> air without restarting the animation */
+static void ftGe_ToAir(Fighter_GObj* gobj, FtMotionId ms)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+#ifndef MUST_MATCH
+    ftGe_Look look;
+    ftGe_SaveLook(fp, &look);
+#endif
+    ftCommon_8007D60C(fp);
+    Fighter_ChangeMotionState(gobj, ms, ftGe_MF_Keep, fp->cur_anim_frame, 1.0f, 0.0f, NULL);
+#ifndef MUST_MATCH
+    ftGe_RestoreLook(gobj, &look);
+#endif
+}
+
+static void ftGe_ToGround(Fighter_GObj* gobj, FtMotionId ms)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+#ifndef MUST_MATCH
+    ftGe_Look look;
+    ftGe_SaveLook(fp, &look);
+#endif
+    ftCommon_8007D7FC(fp);
+    Fighter_ChangeMotionState(gobj, ms, ftGe_MF_Keep, fp->cur_anim_frame, 1.0f, 0.0f, NULL);
+#ifndef MUST_MATCH
+    ftGe_RestoreLook(gobj, &look);
+#endif
+}
+
+static void ftGe_EndGround(Fighter_GObj* gobj)
+{
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        ft_8008A2BC(gobj);
+    }
+}
+
+static void ftGe_EndAir(Fighter_GObj* gobj)
+{
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        ftCo_Fall_Enter(gobj);
+    }
+}
+
+/* Geno's own sounds: bank 55 (geno.ssm), IDs 550000 + k (animation-pipeline projects/geno/rig/moves.py GE_SFX) */
+#define GE_SFX_BEAM_CHARGE 550010
+#define GE_SFX_BEAM_STAR1 550011 /* +1, +2: the second and third stars */
+#define GE_SFX_BEAM_RELEASE 550014
+#define GE_SFX_BEAM_FIRE 550015
+#define GE_SFX_BEAM_FULL 550016
+
+#define GE_STORE_DECAY 150 /* unused since v1.4 removed the store; kept so ftGe_BeamTuning's layout holds */
+
+/* An unusable special does nothing: straight back to Wait or Fall (Melee has no refusal, so this is the refusal). */
+static void ftGe_Refuse(Fighter_GObj* gobj)
+{
+    if (GET_FIGHTER(gobj)->ground_or_air == GA_Air) {
+        ftCo_Fall_Enter(gobj);
+    } else {
+        ft_8008A2BC(gobj);
+    }
+}
+
+static HSD_GObj* ftGe_Whirl(Fighter_GObj* gobj);
+static bool ftGe_WhirlLocked(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    return ftGe_Whirl(gobj) == NULL && (int) gm_GetFrameCount() < fp->u.ge.whirl_lock;
+}
+
+/* ======================================================================================================== projectiles
+ * Geno's item kinds (it/kinds/itgeno.c). Spawns not built yet still log, so the labs can check the frames. */
+#define GE_FINGER_SPEED 4.0f /* units a frame; the article's lifetime (19) makes ~75 units */
+#define GE_FINGER_MAX 2      /* on screen at once */
+#define GE_FINGER_AIR_DIP 0.1745f /* aerial shots angle ~10 degrees down, so a short-hop shot meets standing opponents */
+#define GE_BEAM_SPEED 6.0f   /* units a frame; lifetime 26 makes ~155 units, near full screen */
+
+static void ftGe_HandPos(Fighter_GObj* gobj, Vec3* pos)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    lb_8000B1CC(fp->parts[ftParts_GetBoneIndex(fp, FtPart_RHandN)].joint, NULL, pos);
+    pos->z = 0.0f;
+}
+
+#ifndef MUST_MATCH
+/* animation-pipeline (geno-atk-air): the shots leave the muzzle of the weapon form. Two things moved them:
+ * - the joint: the decomp's Fighter_Part enum has no WaistB, so from part 16 on it is one short of the parts tables, and
