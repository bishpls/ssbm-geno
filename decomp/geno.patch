+/* the end of the aim: read the stick (16 directions; neutral is straight up) and launch */
+static void ftGe_StarRoad_Launch(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    float sx = fp->input.lstick[0].x, sy = fp->input.lstick[0].y;
+    float a;
+    if (sx * sx + sy * sy < 0.3f * 0.3f) {
+        a = GE_PI / 2;
+    } else {
+        if (sx * fp->facing_dir < -0.2f) {
+            ftCommon_UpdateFacing(fp);
+        }
+        a = atan2f(sy, sx * fp->facing_dir);
+        {
+            float q = a / (GE_PI / 8); /* snap to the nearest of 16 directions */
+            a = (GE_PI / 8) * (float) (int) (q + (q >= 0.0f ? 0.5f : -0.5f));
+        }
+    }
+    if (fp->ground_or_air == GA_Ground && a < 0.0f) {
+        a = 0.0f; /* from the ground, no lower than level */
+    }
+    if (fp->ground_or_air == GA_Ground) {
+        ftCommon_8007D60C(fp);
+    }
+    fp->mv.ge.angle = a;
+    fp->mv.ge.vx = STARROAD_SPEED * cosf(a) * fp->facing_dir;
+    fp->mv.ge.vy = STARROAD_SPEED * sinf(a);
+    fp->mv.ge.frames = 0;
+    ftGe_Change(gobj, ftGe_MS_SpecialHi);
+    fp->self_vel.x = fp->mv.ge.vx;
+    fp->self_vel.y = fp->mv.ge.vy;
+    ftGe_StarRoad_Pitch(fp);
+    OSReport("GENO STARROAD angle %d\n", (int) (a * 180.0f / GE_PI));
+}
+
+static void ftGe_HiStart_Anim(Fighter_GObj* gobj)
+{
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        ftGe_StarRoad_Launch(gobj);
+    }
+}
