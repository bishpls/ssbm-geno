+#ifndef MUST_MATCH
+/* geno-fx: the charge draws energy into the barrel (Michael; the SNES Beam's charge: waves of twinkles in an arc ahead of
+ * and above the tip, converging on it while they shimmer white, lavender, blue, the tip flaring as they land). A wave of
+ * small stars every GE_DRAW_PERIOD frames of the charge, timed to land as each star lights (charge frames 11-51 spawn,
+ * 20-60 land); each is EfGeData.dat's three generators for that star (projects/geno/fx/efge.py: an inner and an outer
+ * arc, and the tip's flare), bigger and denser at each star. They're spawned on the hand joint with an AppSRT
+ * (efLib_CreateGenerator_Attach_AddAppSRT, vanilla), so the stars ride it, and the generators' centre is the tip in the
+ * joint's space, so they converge on the tip as he moves (the air charge falls). None past the last star: nothing is
+ * still flying in when the auto-fire comes. Kirby's copy draws into its hand. */
+static const int ftGe_DrawIn[3][3] = { /* a wave landing at star 1, 2, 3: the inner and outer arcs, the tip's flare */
+    { EFGE_DRAW1_INNER, EFGE_DRAW1_OUTER, EFGE_DRAW1_FLARE },
+    { EFGE_DRAW2_INNER, EFGE_DRAW2_OUTER, EFGE_DRAW2_FLARE },
+    { EFGE_DRAW3_INNER, EFGE_DRAW3_OUTER, EFGE_DRAW3_FLARE },
+};
+#define GE_DRAW_PERIOD 10
+#define GE_DRAW_T 9
+void ftGe_BeamDrawIn(Fighter_GObj* gobj, int f, int star_frames, HSD_JObj* hand, f32 along)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    Vec3 hp, tip, off;
+    int lv, k;
+    f -= BEAM_TAP; /* v1.5: the waves land on the stars, which light BEAM_TAP later */
+    if (f < 0) {
+        return;
+    }
+    if (!efGe_Loaded() || hand == NULL || (f + GE_DRAW_T) % GE_DRAW_PERIOD != 0 || f + GE_DRAW_T > 3 * star_frames) {
+        return;
+    }
+    lv = (f + GE_DRAW_T) / star_frames; /* the star this wave lands on (or before) */
+    if (lv < 1) {
+        lv = 1;
+    }
+    if (lv > 3) {
+        lv = 3;
+    }
+    off.x = along;
+    off.y = 0.0f;
+    off.z = 0.0f;
+    lb_8000B1CC(hand, NULL, &hp);
+    lb_8000B1CC(hand, &off, &tip);
+    tip.z = 0.0f;
+    for (k = 0; k < 3; k++) {
+        HSD_Generator* g = efLib_CreateGenerator_Attach_AddAppSRT(ftGe_DrawIn[lv - 1][k], hand);
+        if (g == NULL) {
+            continue;
+        }
+        g->pos.x = tip.x - hp.x; /* the joint's space: the AppSRT carries the joint's position, no rotation */
+        g->pos.y = tip.y - hp.y;
+        g->pos.z = tip.z - hp.z;
+        if (fp->facing_dir < 0.0f && k < 2) { /* the arc is authored facing right */
+            f32 a0 = g->aux.disc.minAngle;
+            g->aux.disc.minAngle = GE_PI - g->aux.disc.maxAngle;
+            g->aux.disc.maxAngle = GE_PI - a0;
+        }
+    }
+    OSReport("GENO DRAW-IN frame %d level %d\n", f, lv);
+}
+#endif
