+#ifndef MUST_MATCH
+/* animation-pipeline (geno-atk-air): down B is either-or (Michael, DESIGN changelog 2026-09-28). SpecialLw and
+ * SpecialAirLw are the charge: the casting pose, arms to the sky, held while the stars light; the release decides.
+ *   - B let go before the mark's frame (a tap): the single-column Blast, marked on frame 10 as before;
+ *   - let go from frame 10 on: the Blast marked at the release, three columns once the second star has lit (24);
+ *   - held to the third star (48): grounded, Geno Flash instead, with no mark; airborne (no Flash there), the widened
+ *     Blast releases itself.
+ * The release is SpecialLwEnd / SpecialAirLwEnd: the mark on its first frame (the script's flag; the distance read
+ * from the stick then), IASA 28 frames after it (a tap's 38), its end where a tap's ended (52 grounded, 36 in the air).
+ * The counter runs one behind the move's frames (the charge's anim callback first runs on its second frame), so a
+ * release on move frame r sees frames == r - 1. */
+#define BLAST_MARK_FRAME 10
+#define GE_SFX_BLAST_STAR2 550012 /* the second star lights: the Beam's second-star sound */
+
+static void ftGe_SpecialLwBegin(Fighter_GObj* gobj, FtMotionId ms)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    ftGe_Change(gobj, ms);
+    fp->mv.ge.frames = 0;
+    fp->mv.ge.stars = 1;
+    fp->mv.ge.flags = 0;
+    fp->accessory4_cb = NULL;
+    ftGe_BlastPlace(gobj); /* v1.5: the mark from the first frame */
+}
+
+void ftGe_SpecialLw_Enter(Fighter_GObj* gobj)
+{
+    ftGe_SpecialLwBegin(gobj, ftGe_MS_SpecialLw);
+}
+
+void ftGe_SpecialAirLw_Enter(Fighter_GObj* gobj)
+{
+    if (GET_FIGHTER(gobj)->cur_pos.y < 0.0f) { /* no Blast below ledge height: edgeguards are cast from above (¬ß8 rule 2) */
+        OSReport("GENO BLAST refused: below ledge height\n");
+        ftGe_Refuse(gobj);
+        return;
+    }
+    ftGe_SpecialLwBegin(gobj, ftGe_MS_SpecialAirLw);
+}
+
+static void ftGe_BlastRelease(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int stars = fp->mv.ge.stars, f = fp->mv.ge.frames;
+    OSReport("GENO BLAST release stars %d move frame %d\n", stars, f + 1);
+    ftGe_Change(gobj, fp->ground_or_air == GA_Air ? ftGe_MS_SpecialAirLwEnd : ftGe_MS_SpecialLwEnd);
+    fp->mv.ge.stars = stars;
+    fp->mv.ge.frames = f;
+    fp->accessory4_cb = ftGe_BlastCb;
+}
