+/* The chime and the sparkle. The chime is SMRPG's own timed-hit sound (ROM 172, "weapon timing": nine bell pings, the
+ * "ding" its rainbow stars play with; bank 55's GENO_TIMED_HIT, projects/geno/sound/timed.py), on the release frame
+ * as SMRPG plays it on the successful press. The sparkle is SMRPG's rainbow timed-hit stars, a burst from the barrel:
+ * Geno's own particle effect (EfGeData.dat generator 22000, projects/geno/fx/efge.py). Kirby's copy bursts from its
+ * hand. A disc without his effect file falls back to Samus's full-charge flash (colour animation 53). */
+#define GE_SFX_TIMED 550054
+#define GE_COLANIM_TIMED 53
+#define GE_EF_TIMED_STARS EFGE_TIMED_STARS
+void ftGe_BeamTimedCue(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    ft_PlaySFX(fp, GE_SFX_TIMED, 0x7F, 0x40);
+    if (efGe_Loaded()) {
