+/* the charge: a star every BEAM_STAR_FRAMES; release fires; shield cancels (the stars are lost, no store); past the
+ * third star's timed window it fires by itself */
+static void ftGe_NLoop_Anim(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int f = ++fp->mv.ge.frames;
+#ifndef MUST_MATCH
+    int stars = ftGe_BeamStars(f);
+    if (f == BEAM_TAP) { /* the charge begins: no charge sound inside the tap window */
+        OSReport("GENO CHARGE sound from frame %d\n", f);
+        ft_80088478(fp, GE_SFX_BEAM_CHARGE, 0x7F, 0x40);
+    }
+    if (!(fp->input.held_buttons[0] & HSD_PAD_B) && f < BEAM_TAP) {
+        OSReport("GENO FINGER from the charge, frame %d\n", f);
+        ftGe_Finger(gobj);
+        return;
+    }
+#else
+    int stars = f / BEAM_STAR_FRAMES;
+#endif
+    if (stars > 3) {
+        stars = 3;
+    }
+    if (stars != fp->mv.ge.stars) {
+        fp->mv.ge.stars = stars;
+        OSReport("GENO STAR %d frame %d\n", stars, f);
+        if (stars >= 1) {
+            ft_PlaySFX(fp, GE_SFX_BEAM_STAR1 + stars - 1, 0x7F, 0x40);
+        }
+    }
+#ifndef MUST_MATCH
+    ftGe_BeamDrawIn(gobj, f, BEAM_STAR_FRAMES, fp->parts[ftParts_GetBoneIndex(fp, GE_PART_RHAND)].joint, GE_BEAM_MUZZLE);
+#endif
+#ifdef MUST_MATCH
+    if (fp->input.pressed_buttons & HSD_PAD_LR) {
+        OSReport("GENO CANCEL %d\n", stars);
+        ft_80088828(fp);
+        if (fp->ground_or_air == GA_Air) {
+            ftCo_Fall_Enter(gobj);
+        } else {
+            ft_8008A2BC(gobj);
+        }
+        return;
+    }
+#endif
+#ifndef MUST_MATCH
+    if (!(fp->input.held_buttons[0] & HSD_PAD_B)) {
+        int timed = ftGe_BeamTimed(f, &stars);    /* the auto-fire below never is */
+        ftGe_BeamFire(gobj, stars);
+        if (timed) {
+            fp->mv.ge.flags |= GE_BEAM_TIMED;
+            OSReport("GENO TIMED %d frame %d\n", stars, f);
+            ftGe_BeamTimedCue(gobj);
+        }
+        return;
+    }
+    if (ftGe_BeamAuto(f)) {
+        ftGe_BeamFire(gobj, stars);
+    }
+#else
+    if (!(fp->input.held_buttons[0] & HSD_PAD_B) || f >= 3 * BEAM_STAR_FRAMES + BEAM_GRACE) {
+        ftGe_BeamFire(gobj, stars);
+    }
+#endif
+}
+
+#ifndef MUST_MATCH
+/* v1.5: the stars light at BEAM_TAP + 20k from the press (40, 60, 80); it fires itself BEAM_GRACE past the third */
+int ftGe_BeamStars(int f)
+{
+    int s = f < BEAM_TAP ? 0 : (f - BEAM_TAP) / BEAM_STAR_FRAMES;
+    return s > 3 ? 3 : s;
+}
+
+int ftGe_BeamAuto(int f)
+{
+    return f >= BEAM_TAP + 3 * BEAM_STAR_FRAMES + BEAM_GRACE;
+}
+
+int ftGe_BeamTimed(int f, int* stars)
+{
+    int k;
+    for (k = 1; k <= 3; k++) {
+        int d = f - BEAM_TAP - k * BEAM_STAR_FRAMES;
+        if (d >= -GE_BEAM_TIMED_WINDOW && d <= GE_BEAM_TIMED_WINDOW) {
+            if (*stars < k) {
+                *stars = k;
+            }
+            return 1;
+        }
+    }
+    return 0;
+}
