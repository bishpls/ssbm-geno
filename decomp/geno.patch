diff --git a/src/melee/ft/kinds/ftGeno/ftgeno.c b/src/melee/ft/kinds/ftGeno/ftgeno.c
new file mode 100644
index 0000000..1d023d1
--- /dev/null
+++ b/src/melee/ft/kinds/ftGeno/ftgeno.c
@@ -0,0 +1,209 @@
+/* animation-pipeline: Geno (Super Mario RPG), a new fighter kind.
+ * Blocky-rig stage: his own skeleton, parts table, model and animations (PlGe*.dat, built by animation-pipeline's
+ * tools/machinima/melee/datkit fighter-build from projects/geno/rig). The move scripts, articles and sounds in PlGe.dat
+ * are still a template's, bone-remapped, until Geno's own replace them; he has no specials yet. */
+#include <melee/it/kinds/itgeno.h>
+#include "ftgeno.h"
+
+#include <melee/ft/ftdata.h>
+#include <melee/ft/ftparts.h>
+#include <melee/ft/inlines.h>
+#include <melee/ft/types.h>
+#include <melee/ft/ftanim.h>
+#include <melee/it/it_26B1.h>
+#include <melee/lb/lbfile.h>
+#include <dolphin/dvd.h>
+#include <dolphin/os.h>
+#include <melee/ft/kinds/ftCommon/forward.h>
+#include <sysdolphin/baselib/jobj.h>
+#include <math.h>
+
+UnkCostumeStruct ftGe_CostumeList[FTGE_COSTUME_COUNT];
+
+char ftGe_Init_DatFilename[] = "PlGe.dat";
+char ftGe_Init_DataName[] = "ftDataGeno";
+char ftGe_Init_AnimDatFilename[] = "PlGeAJ.dat";
+
+#include "ftgeno_rig.inc"
+
+static FighterPartsTable ftGe_PartsTable = { ftGe_JointToPart, ftGe_PartToJoint, FTGE_JOINT_COUNT };
+
+/* his costumes (ftgeno_costumes.h, generated by animation-pipeline projects/geno/model/costumes.py --c): PlGe<Cc>.dat each,
+ * under the vanilla symbols, written by datkit fighter-build with PlGe.dat's per-costume visibility and material rows */
+Fighter_CostumeStrings ftGe_Init_CostumeStrings[FTGE_COSTUME_COUNT] = {
+    FTGE_COSTUME_STRINGS
+};
+
+/* How many of his costumes are on the disc: the leading entries whose file exists (a blocky-rig build, or a sandbox disc
+ * built before the costumes, has PlGeNr.dat only). Counted once, and written into his costume list's count so every
+ * reader agrees: the character select's costume change and random picks, the team colours, the match's clamp
+ * (fighter.c), the all-costume preloads, and the file loads (ftdata.c), which fall back to costume 0 past it. */
+u8 ftGe_NumCostumes(void)
+{
+    static s8 n = -1;
+    if (n < 0) {
+        n = 1;
+        while (n < FTGE_COSTUME_COUNT &&
+               DVDConvertPathToEntrynum(lbFileGetFullName(ftGe_Init_CostumeStrings[n].dat_filename)) != -1)
+        {
+            n++;
+        }
+        CostumeListsForeachCharacter[Ft_Kind_Geno].numCostumes = n;
+        OSReport("GENO costumes %d of %d on the disc\n", n, FTGE_COSTUME_COUNT);
+    }
+    return n;
+}
+
+/* a costume to load for any kind: Geno's past the disc's own are costume 0 */
+int ftGe_ClampCostume(FighterKind kind, int costume_id)
+{
+    if (kind == Ft_Kind_Geno && costume_id >= ftGe_NumCostumes()) {
+        return 0;
+    }
+    return costume_id;
+}
+
+/* the team costume the game's row names (red, blue or green), or costume 0 if the disc lacks it */
+u8 ftGe_TeamCostume(u8 costume)
+{
+    return costume < ftGe_NumCostumes() ? costume : 0;
+}
+
+/* the demo scenes' motion archives: his own results-screen poses (GmRstMGe.dat, root ftDemoResultMotionFileGeno, written by
+ * datkit fighter-build with PlGe.dat's demo rows 0-9); the intro, ending and ViWait rows are still Mario's, in the archives
+ * every fighter shares, so those names stay Mario's */
+Fighter_DemoStrings ftGe_Init_DemoMotionFilenames = {
+    "ftDemoResultMotionFileGeno",
+    "ftDemoIntroMotionFileMario",
+    "ftDemoEndingMotionFileMario",
+    "ftDemoViWaitMotionFileMario",
+};
+
+/* Items: the hand holding one takes a pose while he holds it (model part 1, his right hand; animation-pipeline rig.py
+ * HAND_POSE: 0 fist, 1 open, 2 point, 3 grip). The engine keeps it as the part's default (x8B0[1].x10), set again on every
+ * action change, until the item goes (as Mario's, ftMr_Init_OnItemPickup; his order of poses differs). Handles, guns and
+ * the round throwables (hold kinds 2, 3, 4) take the grip; hold kind 1 (what is used on touch) the open hand; heavy items
+ * none (his palms are flat on the crate). */
+#define FTGE_ITEM_HAND 1
+static void ftGe_ItemHandPose(HSD_GObj* gobj, bool apply)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    s32 pose;
+    if (itIsHeavy(fp->item_gobj)) {
+        return;
+    }
+    switch (itGetHoldKind(fp->item_gobj)) {
+    case 1:
+        pose = 1;
+        break;
+    case 2:
+    case 3:
+    case 4:
+        pose = 3;
+        break;
+    default:
+        return;
+    }
+    ftAnim_80070FB4(gobj, FTGE_ITEM_HAND, pose);
+    if (apply) {
+        ftAnim_80070C48(gobj, FTGE_ITEM_HAND);
+    }
+}
+
+void ftGe_Init_OnItemPickup(HSD_GObj* gobj, bool flag)
+{
+    ftGe_ItemHandPose(gobj, flag);
+}
+
+void ftGe_Init_OnItemInvisible(HSD_GObj* gobj)
+{
+    Fighter_OnItemInvisible(gobj, FTGE_ITEM_HAND);
+}
+
+void ftGe_Init_OnItemVisible(HSD_GObj* gobj)
+{
+    Fighter_OnItemVisible(gobj, FTGE_ITEM_HAND);
+}
+
+void ftGe_Init_OnItemDrop(HSD_GObj* gobj, bool flag)
+{
+    Fighter_OnItemDrop(gobj, flag, FTGE_ITEM_HAND, FTGE_ITEM_HAND);
+}
+
+void ftGe_Init_LoadSpecialAttrs(HSD_GObj* gobj)
+{
+    (void) gobj;
+}
+
+/* Lab trace (dair_fist_lab): down air's fist, every frame of AttackAirLw and LandingAirLw and 8 frames after. His position,
+ * the right hand's world position and scale (the rocket fist), and the four hitboxes (x, y, radius; 0 radius when off). It runs in
+ * procAnim before this frame's animation step, so it reports the frame just drawn (TopN and the hand from one set of
+ * matrices). Part 40 is his right hand (ftgeno_specials.c GE_PART_RHAND), joint 45 through the parts table. */
+static int ftGe_FistTail; /* frames still traced after the down air or its landing (the autocancel's Landing, a Fall) */
+
+static void ftGe_FistTrace(HSD_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    MtxPtr m;
+    HitCapsule* h = fp->x914;
+    f32 r[4];
+    int i;
+    if (fp->motion_id == ftCo_MS_AttackAirLw || fp->motion_id == ftCo_MS_LandingAirLw) {
+        ftGe_FistTail = 8;
+    } else if (ftGe_FistTail > 0) {
+        ftGe_FistTail--;
+    } else {
+        return;
+    }
+    for (i = 0; i < 4; i++) {
+        r[i] = h[i].state != HitCapsule_Disabled ? h[i].scale : 0.0F;
+    }
+    m = HSD_JObjGetMtxPtr(fp->parts[ftParts_GetBoneIndex(fp, 40)].joint);
+    OSReport("GENO FIST %d %.1f %d pos %.2f %.2f hand %.2f %.2f %.3f hb %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f "
+             "%.2f\n",
+             fp->motion_id, fp->cur_anim_frame, fp->ground_or_air, fp->cur_pos.x, fp->cur_pos.y, m[0][3], m[1][3],
+             sqrtf(m[0][0] * m[0][0] + m[1][0] * m[1][0] + m[2][0] * m[2][0]), h[0].x4C.x, h[0].x4C.y, r[0], h[1].x4C.x,
+             h[1].x4C.y, r[1], h[2].x4C.x, h[2].x4C.y, r[2], h[3].x4C.x, h[3].x4C.y, r[3]);
+}
+
+void ftGe_Init_OnLoad(HSD_GObj* gobj)
+{
+    /* his actions are authored for kind 0x22 (flags' low 6 bits), so they play natively; his projectiles' articles are
+     * PlGe.dat's article list, in the order of the Geno item kinds */
+    Fighter* fp = gobj->user_data;
+    void** items = fp->ft_data->x48_items;
+    int i;
+    for (i = 0; i < ITGE_COUNT; i++) {
+        itGe_SetArticle(items[i], It_Kind_Geno_Start + i);
+    }
+    /* the fighter-vars union keeps whatever the last fighter in this memory left there (a menu-path match crashed on a
+     * stale Whirl pointer): start clean */
+    fp->u.ge.stored_stars = 0;
+    fp->u.ge.store_decay = 0;
+    fp->u.ge.whirl = NULL;
+    fp->u.ge.blast = NULL;
+    fp->u.ge.whirl_lock = 0;
+    fp->u.ge.catch_dx = fp->u.ge.catch_dy = 0.0F;
+    ftData_UnkMotionStates3[Ft_Kind_Geno] = ftGe_FistTrace;
+}
+
+void ftGe_Init_OnDeath(HSD_GObj* gobj)
+{
+    /* runs on every spawn and respawn too (fighter.c): every visibility group to its option 0, the default model. Group 0
+     * is the body; the production model adds two groups per hand for the weapon forms (projects/geno/model/geno_forms.py:
+     * the arm's base meshes, then the form), whose option 0 is the plain hand. A group without a default stays hidden. */
+    Fighter* fp = GET_FIGHTER(gobj);
+    u32 i;
+    for (i = 0; i < fp->x5AC.model_num; i++) {
+        ftParts_80074A4C(gobj, i, 0);
+    }
+}
+
+void ftGe_InitCommonData(FighterPartsTable** parts, struct Fighter_804D6540_t** hide)
+{
+    /* his own skeleton's bone roles. The hideable-parts list is by part, not joint, so the standard humanoid one fits */
+    parts[Ft_Kind_Geno] = &ftGe_PartsTable;
+    hide[Ft_Kind_Geno] = hide[Ft_Kind_Mario];
+    /* at boot (PlCo.dat's load), before anything reads his costume count: the preloads walk it (ftData_800855C8) */
+    ftGe_NumCostumes();
+}
