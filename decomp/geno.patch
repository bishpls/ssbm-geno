diff --git a/src/melee/ft/kinds/ftKirby/ftkirbyspecialgeno.c b/src/melee/ft/kinds/ftKirby/ftkirbyspecialgeno.c
new file mode 100644
index 0000000..19c6de4
--- /dev/null
+++ b/src/melee/ft/kinds/ftKirby/ftkirbyspecialgeno.c
@@ -0,0 +1,499 @@
+/* animation-pipeline: Kirby's copy of Geno (kind 0x22), non-matching builds only.
+ *
+ * As the decomp's ftkirbyspecial*.c files are Kirby's versions of each fighter's neutral B, this is Kirby's version of
+ * the Geno Beam (ftGeno/ftgeno_specials.c): tap for Finger Shot; hold to charge through three stars; release to fire;
+ * a shield press cancels the charge (Samus's copy's 8-frame cancel) and its stars are lost (no store, as Geno's since v1.4),
+ * and a grounded sideways smash rolls out of it; just past the third star's
+ * timed window it fires by itself; all of it on the ground and in the air. The frame data, the sounds and the projectiles
+ * are Geno's own (ftGe_BeamNumbers, ftGe_BeamSpawnFinger/Beam: his Finger Shot and Beam items and articles, from
+ * Kirby's hand), the way the game keeps a copy's numbers and shares its fighter's items (Kirby's Samus copy charges 7
+ * levels of 16 frames, as Samus; his Fox and Falco lasers are theirs, damage and all).
+ *
+ * Kirby has no Geno animations (no new art), so the copy plays the Samus copy's charge-shot actions, the closest
+ * analogue (a hand held out, charged, stored, released), retimed to Geno's frames by the animation rate. Samus's
+ * release animation starts on its shot (the recoil is its first frame), while Geno's shots come 7 and 9 frames into
+ * his, so Kirby winds up in the pose he is already in and the release animation starts on the frame the shot leaves:
+ *   Start    SsSpecialNStart / SsSpecialAirNStart  14 frames, over Geno's 8; after a tap, the Finger Shot's windup
+ *   Loop     SsSpecialNHold                        the 10-frame charge loop, grounded and airborne (Geno charges in the
+ *                                                  air; Samus's copy can't, so it has no airborne loop); after the
+ *                                                  release, the Beam's windup
+ *   End      SsSpecialN / SsSpecialAirN            30 frames, from the Beam's spawn to the end of Geno's release
+ *   Finger   SsSpecialN / SsSpecialAirN            30 frames, from the shot to the end of Geno's Finger Shot
+ * The Samus actions' scripts add common-bank effects and rumble; their release also plays Samus's fire sound, which
+ * ftKbGe_StopScriptSfx stops (Geno's own sounds come with the shots).
+ *
+ * The copy keeps no state between uses (no store). The motion vars are Geno's (mv.ge). */
+#ifndef MUST_MATCH
+#include <melee/ft/forward.h>
+
+#include "ftkirby.h"
+#include <dolphin/dvd.h>
+#include <dolphin/os.h>
+#include <melee/ft/fighter.h>
+#include <melee/ft/ft_081B.h>
+#include <melee/ft/ft_084E.h>
+#include <melee/ft/ft_0877.h>
+#include <melee/ft/ft_0881.h>
+#include <melee/ft/ft_0892.h>
+#include <melee/ft/ftanim.h>
+#include <melee/ft/ftcamera.h>
+#include <melee/ft/ftcommon.h>
+#include <melee/ft/inlines.h>
+#include <melee/ft/kinds/ftCommon/ftCo_Escape.h>
+#include <melee/ft/kinds/ftCommon/ftCo_Fall.h>
+#include <melee/ft/kinds/ftCommon/ftCo_Landing.h>
+#include <melee/ft/kinds/ftGeno/ftgeno.h>
+#include <melee/ft/types.h>
+#include <melee/gm/gmvs.h>
+#include <melee/lb/lb_00B0.h>
+#include <melee/lb/lbaudio_ax.h>
+#include <melee/lb/lbfile.h>
+#include <sysdolphin/baselib/controller.h>
+
+#define KBGE_T (&ftGe_BeamNumbers)
+
+
+/* mv.ge.flags */
+#define KBGE_FINGER 0x1     /* a tap: the Finger Shot winds up in the start */
+#define KBGE_RELEASE 0x2    /* released: the Beam winds up in the charge loop */
+#define KBGE_AIR_FINGER 0x4 /* the Finger Shot started airborne (Geno's aerial numbers) */
+#define KBGE_WINDUP(fp) ((fp)->mv.ge.vx) /* frames until the pending shot */
+
+/* Kirby's Samus-copy animation lengths (PlKbAJ.dat, `datkit actions`) */
+#define KB_SS_START_LEN 14.0f
+#define KB_SS_FIRE_LEN 30.0f
+
+/* The rate that plays an animation of `len` frames over a state of `frames` (Geno's length for it: his states run one
+ * frame less than their animations). Half a frame short, so the accumulated float frame is past the end on time. */
+static float ftKbGe_Rate(float len, int frames)
+{
+    return len / ((float) frames - 0.5f);
+}
+
+/* A Samus-copy action's script plays Samus's fire sound on its first frame (SsSpecialN, SsSpecialAirN); a state change
+ * that runs the script up to the current frame replays it. Stop whatever the script started. */
+static void ftKbGe_StopScriptSfx(Fighter* fp, int before)
+{
+    if (fp->x2160 != before && fp->x2160 != -1) {
+        lbAudioAx_800236B8(fp->x2160);
+        fp->x2160 = -1;
+    }
+}
+
+static void ftKbGe_Change(Fighter_GObj* gobj, FtMotionId ms, float rate)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int sfx = fp->x2160;
+    fp->throw_flags = 0;
+    fp->cmd_vars[0] = fp->cmd_vars[1] = fp->cmd_vars[2] = fp->cmd_vars[3] = 0;
+    Fighter_ChangeMotionState(gobj, ms, Ft_MF_None, 0.0f, rate, 0.0f, NULL);
+    ftAnim_8006EBA4(gobj);
+    ftKbGe_StopScriptSfx(fp, sfx);
+}
+
+/* ground <-> air without restarting the animation (or its rate, or the charge sound, or a pending shot) */
+static MotionFlags const ftKbGe_MF_Keep = Ft_MF_KeepFastFall | Ft_MF_KeepGfx | Ft_MF_KeepSfx | Ft_MF_UpdateCmd |
+                                          Ft_MF_SkipColAnim | Ft_MF_SkipModelPartVis | Ft_MF_SkipModelFlags;
+
+static void ftKbGe_Keep(Fighter_GObj* gobj, FtMotionId ms)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int sfx = fp->x2160;
+    HSD_GObjEvent acc = fp->accessory4_cb;
+    Fighter_ChangeMotionState(gobj, ms, ftKbGe_MF_Keep, fp->cur_anim_frame, fp->frame_speed_mul, 0.0f, NULL);
+    fp->accessory4_cb = acc;
+    ftKbGe_StopScriptSfx(fp, sfx);
+}
+
+static void ftKbGe_ToAir(Fighter_GObj* gobj, FtMotionId ms)
+{
+    ftCommon_8007D60C(GET_FIGHTER(gobj));
+    ftKbGe_Keep(gobj, ms);
+}
+
+static void ftKbGe_ToGround(Fighter_GObj* gobj, FtMotionId ms)
+{
+    ftCommon_8007D7FC(GET_FIGHTER(gobj));
+    ftKbGe_Keep(gobj, ms);
+}
+
+static bool ftKbGe_Air(Fighter* fp)
+{
+    return fp->ground_or_air == GA_Air;
+}
+
+/* ---------------------------------------------------------------------------------------------------------- shots
+ * A shot spawns from the accessory callback of the state that starts on its frame, so it leaves the hand after the
+ * frame's movement, as Geno's (his spawn on a script flag, polled there). It leaves from where Kirby's Samus copy fires
+ * its charge shot (its parts[FtPart_R3rdNa]); his right-hand part sits low in these poses. */
+static void ftKbGe_ShotPos(Fighter* fp, Vec3* pos)
+{
+    lb_8000B1CC(fp->parts[FtPart_R3rdNa].joint, NULL, pos);
+    pos->z = 0.0f;
+}
+
+static void ftKbGe_BeamCb(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    Vec3 pos;
+    fp->accessory4_cb = NULL;
+    ftKbGe_ShotPos(fp, &pos);
+    OSReport("KBGE SPAWN beam stars %d port %d at %d %d\n", fp->mv.ge.stars, fp->player_idx, (int) pos.x, (int) pos.y);
+    ftGe_BeamSpawnBeam(gobj, fp->mv.ge.stars, &pos);
+}
+
+static void ftKbGe_FingerCb(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    Vec3 pos;
+    fp->accessory4_cb = NULL;
+    ftKbGe_ShotPos(fp, &pos);
+    OSReport("KBGE SPAWN finger port %d at %d %d\n", fp->player_idx, (int) pos.x, (int) pos.y);
+    ftGe_BeamSpawnFinger(gobj, &pos);
+    ft_PlaySFX(fp, KBGE_T->sfx_finger, 0x7F, 0x40);
+}
+
+/* the Beam leaves: the release animation, for the rest of Geno's release */
+static void ftKbGe_ShootBeam(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int after = KBGE_T->end_frames - (KBGE_T->fire_frame - 1);
+    ftKbGe_Change(gobj, ftKbGe_Air(fp) ? ftKb_MS_GeSpecialAirNEnd : ftKb_MS_GeSpecialNEnd,
+                  ftKbGe_Rate(KB_SS_FIRE_LEN, after));
+    fp->mv.ge.flags &= ~KBGE_RELEASE;
+    fp->accessory4_cb = ftKbGe_BeamCb;
+}
+
+/* the Finger Shot leaves; mv.ge.frames keeps counting from the tap, for the aerial landing rule */
+static void ftKbGe_ShootFinger(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    bool air = fp->mv.ge.flags & KBGE_AIR_FINGER;
+    int after = air ? KBGE_T->air_finger_frames - (KBGE_T->air_finger_fire - 1)
+                    : KBGE_T->finger_frames - (KBGE_T->finger_fire - 1);
+    int since = fp->mv.ge.frames;
+    int flags = fp->mv.ge.flags & ~KBGE_FINGER;
+    ftKbGe_Change(gobj, ftKbGe_Air(fp) ? ftKb_MS_GeSpecialAirNFinger : ftKb_MS_GeSpecialNFinger,
+                  ftKbGe_Rate(KB_SS_FIRE_LEN, after));
+    fp->mv.ge.frames = since;
+    fp->mv.ge.flags = flags;
+    fp->accessory4_cb = ftKbGe_FingerCb;
+}
+
+/* a release: the Beam winds up, in the pose he charges in, for Geno's startup */
+static void ftKbGe_Release(Fighter_GObj* gobj, int stars)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    ft_80088828(fp); /* the charge sound */
+    fp->mv.ge.stars = stars;
+    fp->mv.ge.flags |= KBGE_RELEASE;
+    KBGE_WINDUP(fp) = (float) (KBGE_T->fire_frame - 1);
+}
+
+/* a tap: the Finger Shot winds up, the start playing on */
+static void ftKbGe_Tap(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    bool air = ftKbGe_Air(fp);
+    ft_80088828(fp); /* no charge */
+    fp->mv.ge.flags |= KBGE_FINGER | (air ? KBGE_AIR_FINGER : 0);
+    fp->mv.ge.frames = 1; /* the frame of the tap is the Finger Shot's first */
+    KBGE_WINDUP(fp) = (float) ((air ? KBGE_T->air_finger_fire : KBGE_T->finger_fire) - 1);
+}
+
+/* ---------------------------------------------------------------------------------------------------------- entry */
+static void ftKbGe_Begin(Fighter_GObj* gobj, bool air)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    ftKbGe_Change(gobj, air ? ftKb_MS_GeSpecialAirNStart : ftKb_MS_GeSpecialNStart,
+                  ftKbGe_Rate(KB_SS_START_LEN, KBGE_T->start_frames));
+    fp->mv.ge.frames = 0;
+    fp->mv.ge.stars = 0;
+    fp->mv.ge.flags = 0;
+    fp->accessory4_cb = NULL;
+    /* v1.5: the charge sound starts when a real charge begins (KBGE_T->tap), not at the press */
+}
+
+void ftKb_SpecialNGe_Enter(Fighter_GObj* gobj)
+{
+    ftKbGe_Begin(gobj, false);
+}
+
+void ftKb_SpecialAirNGe_Enter(Fighter_GObj* gobj)
+{
+    ftKbGe_Begin(gobj, true);
+}
+
+/* ---------------------------------------------------------------------------------------------------------- states */
+/* the start: a tap (B released early) is Finger Shot; held through the start, the charge begins */
+void ftKb_GeSpecialNStart_Anim(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    fp->mv.ge.frames++;
+    if (fp->mv.ge.flags & KBGE_FINGER) {
+        if (--KBGE_WINDUP(fp) <= 0.0f) {
+            ftKbGe_ShootFinger(gobj);
+        }
+        return;
+    }
+    if (!(fp->input.held_buttons[0] & HSD_PAD_B) && fp->mv.ge.frames < KBGE_T->tap) {
+        ftKbGe_Tap(gobj);
+        return;
+    }
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        if (!(fp->input.held_buttons[0] & HSD_PAD_B)) {
+            ftKbGe_Tap(gobj);
+            return;
+        }
+        /* frames keeps counting from the start: the stars are timed from the press */
+        ftKbGe_Change(gobj, ftKbGe_Air(fp) ? ftKb_MS_GeSpecialAirNLoop : ftKb_MS_GeSpecialNLoop, 1.0f);
+    }
+}
+
+/* the charge: a star every star_frames; release fires; shield cancels (no store, as Geno's); past the third star's
+ * timed window it fires by itself */
+void ftKb_GeSpecialNLoop_Anim(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int f, stars;
+    if (fp->mv.ge.flags & KBGE_RELEASE) {
+        if (--KBGE_WINDUP(fp) <= 0.0f) {
+            ftKbGe_ShootBeam(gobj);
+        }
+        return;
+    }
+    if (fp->mv.ge.flags & KBGE_FINGER) { /* a tap from the charge (v1.5: before frame 20): the Finger Shot's windup */
+        if (--KBGE_WINDUP(fp) <= 0.0f) {
+            ftKbGe_ShootFinger(gobj);
+        }
+        return;
+    }
+    f = ++fp->mv.ge.frames;
+    if (f == KBGE_T->tap) {
+        ft_80088478(fp, KBGE_T->sfx_charge, 0x7F, 0x40);
+    }
+    if (!(fp->input.held_buttons[0] & HSD_PAD_B) && f < KBGE_T->tap) {
+        ftKbGe_Tap(gobj);
+        return;
+    }
+    stars = ftGe_BeamStars(f);
+    if (stars != fp->mv.ge.stars) {
+        fp->mv.ge.stars = stars;
+        OSReport("KBGE STAR %d frame %d port %d\n", stars, f, fp->player_idx);
+        if (stars >= 1) {
+            ft_PlaySFX(fp, KBGE_T->sfx_star1 + stars - 1, 0x7F, 0x40);
+        }
+    }
+    ftGe_BeamDrawIn(gobj, f, KBGE_T->star_frames, fp->parts[FtPart_R3rdNa].joint, 0.0f); /* into the shot point */
+    if (!(fp->input.held_buttons[0] & HSD_PAD_B)) {
+        int timed = ftGe_BeamTimed(f, &stars);   /* Geno's timed release: the same window, bonus, chime and sparkle */
+        ftKbGe_Release(gobj, stars);
+        if (timed) {
+            fp->mv.ge.flags |= GE_BEAM_TIMED;
+            OSReport("KBGE TIMED %d frame %d port %d\n", stars, f, fp->player_idx);
+            ftGe_BeamTimedCue(gobj);
+        }
+        return;
+    }
+    if (ftGe_BeamAuto(f)) {
+        ftKbGe_Release(gobj, stars);
+    }
+}
+
+/* the cancel, as Geno's (ftgeno_specials.c ftGe_NLoop_IASA): a grounded sideways smash rolls out; a shield press plays
+ * the cancel (the Samus copy's 8 frames: Geno's length) into Wait or Fall; the stars are lost. Not during a pending
+ * release's windup (the shot is committed) */
+static void ftKbGe_Cancel(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int sfx;
+    OSReport("KBGE CANCEL %d port %d\n", fp->mv.ge.stars, fp->player_idx);
+    ft_80088828(fp);
+    /* as the Samus copy's own cancel: no first-frame advance (ftKbGe_Change's ftAnim_8006EBA4), so its 8 frames */
+    sfx = fp->x2160;
+    fp->throw_flags = 0;
+    fp->cmd_vars[0] = fp->cmd_vars[1] = fp->cmd_vars[2] = fp->cmd_vars[3] = 0;
+    Fighter_ChangeMotionState(gobj, ftKbGe_Air(fp) ? ftKb_MS_GeSpecialAirNCancel : ftKb_MS_GeSpecialNCancel, Ft_MF_None,
+                              0.0f, 1.0f, 0.0f, NULL);
+    ftKbGe_StopScriptSfx(fp, sfx);
+    fp->accessory4_cb = NULL;
+    ft_PlaySFX(fp, 550052, 0x7F, 0x40); /* Geno's wooden rattle (his cancel script plays it) */
+}
+
+void ftKb_GeSpecialNLoop_IASA(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    if (fp->mv.ge.flags & KBGE_RELEASE) {
+        return;
+    }
+    if (ftCo_8009917C(gobj)) {
+        OSReport("KBGE CANCEL roll %d port %d\n", fp->mv.ge.stars, fp->player_idx);
+        ft_80088828(fp);
+        return;
+    }
+    if (fp->input.pressed_buttons & HSD_PAD_LR) {
+        ftKbGe_Cancel(gobj);
+    }
+}
+
+void ftKb_GeSpecialAirNLoop_IASA(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    if (!(fp->mv.ge.flags & KBGE_RELEASE) && (fp->input.pressed_buttons & HSD_PAD_LR)) {
+        ftKbGe_Cancel(gobj);
+    }
+}
+
+void ftKb_GeSpecialNCancel_Anim(Fighter_GObj* gobj)
+{
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        ft_8008A2BC(gobj);
+    }
+}
+
+void ftKb_GeSpecialAirNCancel_Anim(Fighter_GObj* gobj)
+{
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        ftCo_Fall_Enter(gobj);
+    }
+}
+
+void ftKb_GeSpecialNCancel_Coll(Fighter_GObj* gobj)
+{
+    if (!ft_80082708(gobj)) {
+        ftKbGe_ToAir(gobj, ftKb_MS_GeSpecialAirNCancel);
+    }
+}
+
+void ftKb_GeSpecialAirNCancel_Coll(Fighter_GObj* gobj)
+{
+    if (ft_80081D0C(gobj)) {
+        ftKbGe_ToGround(gobj, ftKb_MS_GeSpecialNCancel);
+    }
+}
+
+void ftKb_GeSpecialN_Anim(Fighter_GObj* gobj) /* after a shot, grounded */
+{
+    GET_FIGHTER(gobj)->mv.ge.frames++;
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        ft_8008A2BC(gobj);
+    }
+}
+
+void ftKb_GeSpecialAirN_Anim(Fighter_GObj* gobj) /* after a shot, airborne */
+{
+    GET_FIGHTER(gobj)->mv.ge.frames++;
+    if (!ftAnim_IsFramesRemaining(gobj)) {
+        ftCo_Fall_Enter(gobj);
+    }
+}
+
+void ftKb_GeSpecialN_IASA(Fighter_GObj* gobj)
+{
+    (void) gobj; /* Geno's neutral B is interruptible only at its ends */
+}
+
+void ftKb_GeSpecialN_Phys(Fighter_GObj* gobj)
+{
+    ft_80084F3C(gobj);
+}
+
+void ftKb_GeSpecialAirN_Phys(Fighter_GObj* gobj)
+{
+    ft_80084DB0(gobj); /* Geno's aerial neutral B: normal gravity and drift */
+}
+
+void ftKb_GeSpecialNStart_Coll(Fighter_GObj* gobj)
+{
+    if (!ft_80082708(gobj)) {
+        ftKbGe_ToAir(gobj, ftKb_MS_GeSpecialAirNStart);
+    }
+}
+
+void ftKb_GeSpecialAirNStart_Coll(Fighter_GObj* gobj)
+{
+    if (ft_80081D0C(gobj)) {
+        if (GET_FIGHTER(gobj)->mv.ge.flags & KBGE_FINGER) {
+            /* Geno's aerial Finger Shot, landing before the shot: his landing lag, and the shot is lost */
+            ftCo_LandingFallSpecial_Enter(gobj, false, KBGE_T->air_finger_lag);
+            return;
+        }
+        ftKbGe_ToGround(gobj, ftKb_MS_GeSpecialNStart);
+    }
+}
+
+void ftKb_GeSpecialNLoop_Coll(Fighter_GObj* gobj)
+{
+    if (!ft_80082708(gobj)) {
+        ftKbGe_ToAir(gobj, ftKb_MS_GeSpecialAirNLoop);
+    }
+}
+
+void ftKb_GeSpecialAirNLoop_Coll(Fighter_GObj* gobj)
+{
+    if (ft_80081D0C(gobj)) {
+        if (GET_FIGHTER(gobj)->mv.ge.flags & KBGE_RELEASE) {
+            /* Geno's aerial release, landing before the Beam: his landing lag, and the Beam is lost */
+            ftCo_LandingFallSpecial_Enter(gobj, false, KBGE_T->air_end_lag);
+            return;
+        }
+        ftKbGe_ToGround(gobj, ftKb_MS_GeSpecialNLoop);
+    }
+}
+
+void ftKb_GeSpecialNEnd_Coll(Fighter_GObj* gobj)
+{
+    if (!ft_80082708(gobj)) {
+        ftKbGe_ToAir(gobj, ftKb_MS_GeSpecialAirNEnd);
+    }
+}
+
+void ftKb_GeSpecialAirNEnd_Coll(Fighter_GObj* gobj)
+{
+    if (ft_80081D0C(gobj)) {
+        ftCo_LandingFallSpecial_Enter(gobj, false, KBGE_T->air_end_lag); /* landing during the release */
+    }
+}
+
+void ftKb_GeSpecialNFinger_Coll(Fighter_GObj* gobj)
+{
+    if (!ft_80082708(gobj)) {
+        ftKbGe_ToAir(gobj, ftKb_MS_GeSpecialAirNFinger);
+    }
+}
+
+void ftKb_GeSpecialAirNFinger_Coll(Fighter_GObj* gobj)
+{
+    if (ft_80081D0C(gobj)) {
+        if (GET_FIGHTER(gobj)->mv.ge.frames < KBGE_T->air_finger_lag_until) {
+            ftCo_LandingFallSpecial_Enter(gobj, false, KBGE_T->air_finger_lag);
+        } else {
+            ft_8008A2BC(gobj);
+        }
+    }
+}
+
+/* ---------------------------------------------------------------------------------------------------------- the hat
+ * No Geno hat exists yet, so by default Kirby wears none while he holds the copy. The hat file is looked for on the disc
+ * once: PlKbCpGe.dat with the root ftDataKirbyCopyGeno, a KirbyHatStruct like Mario's and Luigi's caps (projects/geno/
+ * DESIGN.md ¬ß12 has the interface). When it's there, Geno's row of the hat-file table names it, and Kirby's preload,
+ * load and hat callbacks take it like any vanilla hat. */
+static char ftKbGe_HatFile[] = "PlKbCpGe.dat";
+static char ftKbGe_HatSymbol[] = "ftDataKirbyCopyGeno";
+
+void ftKb_SpecialNGe_HatRow(int kind)
+{
+    static int looked;
+    if (kind != Ft_Kind_Geno || looked) {
+        return;
+    }
+    looked = true;
+    if (DVDConvertPathToEntrynum(lbFileGetFullName(ftKbGe_HatFile)) != -1) {
+        ftKb_Init_803CA9D0[Ft_Kind_Geno].filename = ftKbGe_HatFile;
+        ftKb_Init_803CA9D0[Ft_Kind_Geno].name = ftKbGe_HatSymbol;
+        OSReport("KBGE hat: %s\n", ftKbGe_HatFile);
+    } else {
+        OSReport("KBGE hat: none (no %s on the disc)\n", ftKbGe_HatFile);
+    }
+}
+#endif
