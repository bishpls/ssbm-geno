+#ifndef MUST_MATCH
+/* animation-pipeline (geno-atk-air): the charge's cancel, the way Samus's and Mewtwo's work (Michael: shield-cancellable
+ * as theirs, but never stored). The loop's IASA, after its anim callback as the engine orders them (a release or the
+ * auto-fire that frame wins):
+ *   - grounded, a sideways smash of either stick rolls out (ftCo_8009917C, the check both their charge holds make);
+ *   - a shield press enters the cancel, 8 frames as both of theirs (and Kirby's Samus copy), with no interrupt: grounded
+ *     it ends in Wait (whose IASA lets a held shield in), airborne in Fall, and it crosses between the two as Mewtwo's;
+ * the stars are lost either way. The cancel's animation folds the Beam barrel back into a hand as the charge fizzles; its
+ * script plays the wooden rattle. */
+static void ftGe_BeamCancel(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    ftGe_Look look;
+    OSReport("GENO CANCEL %d\n", fp->mv.ge.stars);
+    ft_80088828(fp); /* the charge hum */
+    /* as Samus's (ftSs_SpecialNHold_IASA): the state changes in the IASA with no first-frame advance (ftGe_Change's
+     * ftAnim_8006EBA4 would play the cancel's first frame at once and leave 7 frames), so the cancel lasts her 8. Its
+     * script's first commands then run on the next frame: the look is carried over so the barrel doesn't blink off */
+    ftGe_SaveLook(fp, &look);
+    fp->throw_flags = 0;
+    fp->cmd_vars[0] = 0;
+    Fighter_ChangeMotionState(gobj, fp->ground_or_air == GA_Air ? ftGe_MS_SpecialAirNCancel : ftGe_MS_SpecialNCancel,
+                              Ft_MF_None, 0.0f, 1.0f, 0.0f, NULL);
+    ftGe_RestoreLook(gobj, &look);
+    fp->accessory4_cb = NULL;
+}
