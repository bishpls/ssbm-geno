--- /dev/null
+++ b/src/melee/ft/kinds/ftGeno/ftgeno_throw.c
@@ -0,0 +1,130 @@
+/* animation-pipeline: Geno's throws fire real projectiles (DESIGN.md ¬ß6f), as Fox's and Falco's do.
+ *   Up throw    the Star Gun salvo: three small stars from the Star Gun's muzzle along its barrel (the Beam article's
+ *               throw state), after the release, so good DI slips some
+ *   Down throw  the point-blank Finger Shot: a volley from the Finger Shot's tubes along the finger into the opponent he
+ *               has pinned to the floor (the Finger Shot article's throw state), before the release
+ * The throw's script raises throw_flags_b0 (fcmd `flag()`) on each shot's frame. The common throw animation callbacks
+ * (ftCo_Throw.c, ftCo_Throw*_Anim) call ftGe_Throw_Anim for every fighter, as they call Fox's ftFx_Throw_Anim; it only acts
+ * for Geno. The forward and back throws carry no projectile: the rocket fist and the cannon blast are the launch itself.
+ *
+ * Joints: the engine's part numbers here are PlCo.dat's order (rig.py PARTS), which the decomp's Fighter_Part enum is one
+ * short of from part 16 on (it has no WaistB), so its FtPart_RHandN (39) is the forearm, RArmJ. Part 40 is the hand. */
+#ifndef MUST_MATCH
+#include "ftgeno.h"
+
+#include <math.h>
+#include <dolphin/os.h>
+#include <melee/ft/fighter.h>
+#include <melee/ft/ft_0877.h>
+#include <melee/ft/ftparts.h>
+#include <melee/ft/inlines.h>
+#include <melee/ft/types.h>
+#include <melee/ft/kinds/ftCommon/forward.h>
+#include <melee/it/forward.h>
+#include <melee/it/kinds/itfoxlaser.h>
+#include <melee/lb/lb_00B0.h>
+
+#define GE_PART_RHANDN 40            /* PlCo.dat's part 40: the right hand (HandN), the gun hand */
+#define GE_THROW_STAR_STATE 3        /* the Beam article's throw state (projects/geno/rig/articles.py) */
+#define GE_THROW_SHOT_STATE 1        /* the Finger Shot article's throw state */
+#define GE_STAR_MUZZLE 2.4f          /* the Star Gun's muzzle: this far past the hand down its barrel (HandN's +X) */
+#define GE_FINGER_MUZZLE 1.6f        /* the Finger Shot's tube ends */
+#define GE_STAR_SPEED 6.5f           /* units a frame (5 until 2026-09-29: the salvo now chases them from the release) */
+#define GE_STAR_SPRAY 6.0f           /* the salvo's spray (Michael, 2026-09-29), degrees off the barrel: the first star
+                                      * straight up it, then alternating, each wider by this: 0, 6, 12 (a fourth 18) */
+#define GE_STAR_DRIFT 0.4f           /* the opponent's sideways launch speed (units a frame, toward his front or back)
+                                      * past which DI has carried them off the barrel's line: the spray's widest stars (the
+                                      * even ones) then go their way, the odd ones the other way (Michael, 2026-09-29: the
+                                      * salvo should "reliably link (with simple DI at least)" at low percents); below it
+                                      * (no DI) the odd stars go toward his front */
+#define GE_SHOT_SPEED 4.0f
+#define GE_SFX_STARGUN 550004        /* moves.py GE_SFX STARGUN, FINGERSHOT */
+#define GE_SFX_FINGERSHOT 550009
+
+/* The muzzle `len` past the right hand along its barrel, and the barrel's angle in the stage plane (radians, as
+ * it_8029C504 takes it: 0 is +x). */
+static f32 ftGe_Muzzle(Fighter* fp, f32 len, Vec3* muzzle)
+{
+    HSD_JObj* hand = fp->parts[ftParts_GetBoneIndex(fp, GE_PART_RHANDN)].joint;
+    Vec3 off, base;
+    off.x = len;
+    off.y = off.z = 0.0F;
+    lb_8000B1CC(hand, NULL, &base);
+    lb_8000B1CC(hand, &off, muzzle);
+    muzzle->z = 0.0F;
+    return atan2f(muzzle->y - base.y, muzzle->x - base.x);
+}
+
+/* Each player's salvo (by player slot): the stars so far (zeroed while he holds the opponent, counted up by each star),
+ * the opponent he held, and the side the odd stars spray to (+1 his front, -1 his back), set on the first star. */
+static u8 ftGe_StarCount[6];
+static s8 ftGe_StarSide[6];
+static Fighter_GObj* ftGe_StarVictim[6];
+
+/* The labs' measure of a throw's launch: the opponent's knockback, its angle and launch velocity (DI included), logged
+ * on the frame after the release (the release clears victim_gobj). */
+static Fighter_GObj* ftGe_ThrowVictim;
+
+static void ftGe_ThrowLog(Fighter* fp)
+{
+    if (fp->victim_gobj != NULL) {
+        ftGe_ThrowVictim = fp->victim_gobj;
+    } else if (ftGe_ThrowVictim != NULL) {
+        Fighter* v = GET_FIGHTER(ftGe_ThrowVictim);
+        OSReport("GENO THROWKB %d kb %.2f angle %d vel %.3f %.3f pct %.1f\n", (int) fp->motion_id, v->dmg.kb_applied,
+                 v->dmg.x1848_kb_angle, v->x8c_kb_vel.x, v->x8c_kb_vel.y, v->dmg.x1830_percent);
+        ftGe_ThrowVictim = NULL;
+    }
+}
+
+void ftGe_Throw_Anim(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    Vec3 pos;
+    f32 angle;
+    if (fp->kind != Ft_Kind_Geno) {
+        return;
+    }
+    ftGe_ThrowLog(fp);
+    if (fp->victim_gobj != NULL) {
+        ftGe_StarCount[fp->player_idx] = 0;
+        ftGe_StarVictim[fp->player_idx] = fp->victim_gobj;
+    }
+    if (!fp->throw_flags_b0) {
+        return;
+    }
+    fp->throw_flags_b0 = false;
+    switch (fp->motion_id) {
+    case ftCo_MS_ThrowHi: {
+        /* the spray: star k leaves k x GE_STAR_SPRAY off the barrel, alternating sides; the widest (even k) go the way
+         * the opponent's launch carries them (their knockback velocity, DI included), the odd ones the other way */
+        int k = ftGe_StarCount[fp->player_idx]++;
+        f32 spray;
+        if (k == 0) {
+            f32 v = 0.0F;
+            if (ftGe_StarVictim[fp->player_idx] != NULL) {
+                v = GET_FIGHTER(ftGe_StarVictim[fp->player_idx])->x8c_kb_vel.x * fp->facing_dir;
+            }
+            ftGe_StarSide[fp->player_idx] = v >= GE_STAR_DRIFT ? -1 : 1;
+        }
+        spray = GE_STAR_SPRAY * (f32) k * ((k & 1) ? 1.0F : -1.0F) * (f32) ftGe_StarSide[fp->player_idx];
+        angle = ftGe_Muzzle(fp, GE_STAR_MUZZLE, &pos) - fp->facing_dir * spray * (3.14159265F / 180.0F);
+        it_8029C504(gobj, &pos, GE_THROW_STAR_STATE, It_Kind_Geno_Beam, angle, GE_STAR_SPEED);
+        ft_PlaySFX(fp, GE_SFX_STARGUN, 0x7F, 0x40);
+        OSReport("GENO THROWSHOT star %d %.2f %.2f %d spray %d front\n", (int) fp->cur_anim_frame, pos.x, pos.y,
+                 (int) (angle * 57.2958F), (int) spray);
+        break;
+    }
+    case ftCo_MS_ThrowLw:
+        angle = ftGe_Muzzle(fp, GE_FINGER_MUZZLE, &pos);
+        it_8029C504(gobj, &pos, GE_THROW_SHOT_STATE, It_Kind_Geno_Finger, angle, GE_SHOT_SPEED);
+        ftGe_FingerPuff(gobj, &pos);
+        ft_PlaySFX(fp, GE_SFX_FINGERSHOT, 0x7F, 0x40);
+        OSReport("GENO THROWSHOT finger %d %.2f %.2f %d\n", (int) fp->cur_anim_frame, pos.x, pos.y,
+                 (int) (angle * 57.2958F));
+        break;
+    default:
+        break;
+    }
+}
+#endif
