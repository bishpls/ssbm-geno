+#ifndef MUST_MATCH
+/* geno-cannon: Geno Flash's full-body cannon (DESIGN ¬ß12; projects/geno/model/geno_cannon.py). The fireball leaves the
+ * cannon's muzzle: FTGE_CANNON_MUZZLE along its barrel joint's +Z (ftgeno_rig.inc, from rig.py: the cannon's joints have
+ * no parts, so they are addressed by joint index). The move script (moves.py flash_cannon) shows the cannon */
+static void ftGe_FlashMuzzle(Fighter_GObj* gobj, Vec3* pos)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    Vec3 off;
+    off.x = 0.0f;
+    off.y = 0.0f;
+    off.z = FTGE_CANNON_MUZZLE;
+    lb_8000B1CC(fp->parts[FTGE_JOINT_CANNONBARREL].joint, &off, pos);
+    OSReport("GENO MUZZLE flash cannon fwd %d up %d depth %d (x100) anim %d\n",
+             (int) ((pos->x - fp->cur_pos.x) * fp->facing_dir * 100.0f), (int) ((pos->y - fp->cur_pos.y) * 100.0f),
+             (int) (pos->z * 100.0f), (int) fp->cur_anim_frame);
+    pos->z = 0.0f;
+}
+
+/* SMRPG's fireball: from the cannon's muzzle to the sun's centre, leaving on GE_FLASH_FIREBALL_FRAME so it arrives
+ * (efge.py FIREBALL_T frames later) as the sun spawns on the script's flag */
+#define GE_FLASH_FIREBALL_FRAME 49
+#define GE_FLASH_FIREBALL_T 5
+static void ftGe_FlashFireball(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    Vec3 muzzle;
+    HSD_Generator* g;
+    if (!efGe_Loaded()) {
+        return;
+    }
+    ftGe_FlashMuzzle(gobj, &muzzle);
+    g = efLib_CreateGenerator(EFGE_FLASH_FIREBALL, &muzzle);
+    if (g != NULL) {
+        g->vel.x = (fp->cur_pos.x + fp->facing_dir * GE_FLASH_AHEAD - muzzle.x) / GE_FLASH_FIREBALL_T;
+        g->vel.y = (fp->cur_pos.y + GE_FLASH_HIGH - muzzle.y) / GE_FLASH_FIREBALL_T;
+        g->vel.z = 0.0f;
+    }
+    OSReport("GENO FLASH fireball frame %d\n", (int) fp->cur_anim_frame);
+}
+#endif
+
+static void ftGe_FlashCb(Fighter_GObj* gobj)
+{
+#ifndef MUST_MATCH
+    Fighter* fp = GET_FIGHTER(gobj);
