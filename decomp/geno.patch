+            ((itGe_BlastAttr*) itGe_Articles[It_Kind_Geno_Blast - It_Kind_Geno_Start]->x4_specialAttributes)->lift;
+    pos.z = 0.0f;
+    spawn.kind = It_Kind_Geno_Blast;
+    Item_InitSpawnPositionFromParent(&spawn, owner, &pos);
