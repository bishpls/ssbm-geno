+/* ---- Geno Blast (down B): a mark on the floor (the tell), then a column sweeps down through it. It meteors airborne
+ * targets and pops grounded ones up (the article's strike script: aerial-only and grounded-only spheres), survives
+ * Geno being hit, and passes through platforms (it has no terrain collision). */
+typedef struct itGe_BlastAttr {
+    f32 mark;   /* mark frames */
+    f32 strike; /* strike frames */
+    f32 drop;   /* the column starts this far above the mark */
+    f32 lift;   /* the model hangs this far below its root (the stand-in, Pikachu's thunder: one quad, y -40..0), so the
+                 * item rides this high: the tell stands on the floor, and the strike's hitboxes (the article script puts
+                 * them this far down) sit at the bolt's leading lower end. Where they strike is unchanged */
+} itGe_BlastAttr;
+
+enum { GE_BLAST_MARK, GE_BLAST_STRIKE };
+#define BV(ip) ((ip)->xDD4_itemVar.genoblast)
+#define BA(ip) ((itGe_BlastAttr*) (ip)->xC4_article_data->x4_specialAttributes)
+
+/* geno-fx: the Blast's look (projects/geno/fx/blast_model.py, efge.py BLAST_*): the mark's tell (the floor oval and its
+ * beam, in the model) sends up a few sparkles; each column is one of SMRPG's colours in turn (the model's strike group
+ * holds one column per colour, the rest are hidden); the column lands in a white cloud */
+#define GE_BLAST_TELL_EVERY 12
+#define GE_BLAST_TELL_SOON 9
+static int itGe_BlastColours;
+
+/* geno-fx (2026-09-30): is there a floor under the column's foot? Over the void the mark hangs on nothing (the column
+ * sweeps a fixed drop below him), so the model's floor parts (the oval, the foot's flare) are hidden, the column fades
+ * into the depths (its void tail) and no cloud lands. Whatever floor the mark was given, it is checked where it is */
+static bool itGe_BlastOnFloor(Item* ip);
+
+/* geno-fx: a pending mark taken away (the cannon committing to Geno Flash, a ledge grab): its ring closes in and a few
+ * sparkles lift away (EfGeData.dat BLAST_VANISH). Call it just before the item goes */
+void itGe_BlastVanish(HSD_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    Vec3 at;
+    if (!efGe_Loaded()) {
+        return;
+    }
+    at.x = ip->pos.x;
+    at.y = BV(ip).floor_y;
+    at.z = 0.0f;
+    efSync_Spawn(EFGE_BLAST_VANISH, g, &at);
+}
+
+static bool itGe_BlastOnFloor(Item* ip)
+{
+    Vec3 hit, normal;
+    int line;
+    u32 flags;
+    return mpCheckFloor(ip->pos.x, BV(ip).floor_y + 4.0f, ip->pos.x, BV(ip).floor_y - 4.0f, 0.0f, &hit, &line, &flags,
+                        &normal, -1, -1, -1, NULL, NULL);
+}
+static void itGe_BlastFx(Item_GObj* g, int gfx)
+{
+    Item* ip = GET_ITEM(g);
+    Vec3 at;
+    if (efGe_Loaded()) {
+        at.x = ip->pos.x;
+        at.y = BV(ip).floor_y;
+        at.z = 0.0f;
+        efSync_Spawn(gfx, g, &at);
+    }
+}
+
+static void itGe_BlastColour(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    HSD_JObj* mark = HSD_JObjGetChild(GET_JOBJ(g));
+    HSD_JObj* grp = mark != NULL ? HSD_JObjGetNext(mark) : NULL;
+    HSD_JObj* c;
+    int k = 0, n = 0;
+    bool onfloor;
+    if (grp == NULL) {
+        return; /* a donor model */
+    }
+    for (c = HSD_JObjGetChild(grp); c != NULL; c = HSD_JObjGetNext(c)) {
+        n++;
+    }
+    BV(ip).colour = n > 0 ? itGe_BlastColours++ % n : 0;
+    onfloor = itGe_BlastOnFloor(ip);
+    if (HSD_JObjGetChild(mark) != NULL && !onfloor) {
+        HSD_JObjSetFlags(HSD_JObjGetChild(mark), JOBJ_HIDDEN); /* the floor oval */
+    }
+    for (c = HSD_JObjGetChild(grp); c != NULL; c = HSD_JObjGetNext(c), k++) {
+        HSD_JObj* foot = HSD_JObjGetChild(c);
+        HSD_JObj* tail = foot != NULL ? HSD_JObjGetNext(foot) : NULL;
+        if (k != BV(ip).colour) { /* hidden, not scaled to 0: a camera-facing joint divides by its own axes; the
+                                   * flag hides a joint's own meshes, not its children's, so its foot and tail too */
+            HSD_JObjSetFlags(c, JOBJ_HIDDEN);
+            if (foot != NULL) {
+                HSD_JObjSetFlags(foot, JOBJ_HIDDEN);
+            }
+            if (tail != NULL) {
+                HSD_JObjSetFlags(tail, JOBJ_HIDDEN);
+            }
+        } else if (foot != NULL && tail != NULL) {
+            HSD_JObjSetFlags(onfloor ? tail : foot, JOBJ_HIDDEN);
+        }
+    }
+    OSReport("GENO BLAST draw x %d floor %d on the floor %d\n", (int) ip->pos.x, (int) BV(ip).floor_y, onfloor);
+}
+
+/* v1.5: a shown mark (not yet released) lives only while its owner charges or releases down B */
+static bool itGe_BlastOwnerCasting(Item* ip)
+{
+    Fighter* fp;
+    if (ip->owner == NULL || !ftLib_IsFighter(ip->owner)) {
+        return false;
+    }
+    fp = GET_FIGHTER(ip->owner);
+    return fp->motion_id == ftGe_MS_SpecialLw || fp->motion_id == ftGe_MS_SpecialAirLw ||
+           fp->motion_id == ftGe_MS_SpecialLwEnd || fp->motion_id == ftGe_MS_SpecialAirLwEnd;
+}
+
+static bool itGe_Blast_Anim(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    if (BV(ip).phase == GE_BLAST_MARK && itGe_OwnerForbids(ip)) {
+        itGe_BlastVanish(g);
+        return true; /* a pending mark is cancelled; a falling column finishes */
+    }
+    if (BV(ip).armed < 0 || (BV(ip).armed == 0 && !itGe_BlastOwnerCasting(ip))) {
+        OSReport("GENO BLAST mark gone (%s)\n", BV(ip).armed < 0 ? "cleared" : "the cast ended unreleased");
+        itGe_BlastVanish(g); /* geno-fx: the ring closes, sparkles lift away */
+        return true;
+    }
+    BV(ip).age++;
+    /* geno-fx: the tell's sparkles, sparse while the mark stands (v1.5: from the press, through the whole charge),
+     * quickening over its last frames once released: the strike is coming */
+    if (BV(ip).phase == GE_BLAST_MARK &&
+        (BV(ip).armed == 1 && BA(ip)->mark - BV(ip).t <= GE_BLAST_TELL_SOON ? BV(ip).age % 3 == 0
+                                                                              : BV(ip).age % GE_BLAST_TELL_EVERY == 1))
+    {
+        itGe_BlastFx(g, EFGE_BLAST_TELL);
+    }
+    if (BV(ip).armed == 0) {
+        return false; /* shown: the tell doesn't count down until the release */
+    }
+    BV(ip).t++;
+    if (BV(ip).phase == GE_BLAST_STRIKE && BV(ip).t >= BA(ip)->strike && itGe_BlastOnFloor(ip)) {
+        itGe_BlastFx(g, EFGE_BLAST_LAND); /* over the void, nothing lands: the column fades into the depths */
+    }
+    if (BV(ip).phase == GE_BLAST_MARK) {
+        if (BV(ip).t >= BA(ip)->mark) {
+            BV(ip).phase = GE_BLAST_STRIKE;
+            BV(ip).t = 0;
+            ip->pos.y = BV(ip).floor_y + BA(ip)->lift + BA(ip)->drop;
+            Item_80268E5C(g, GE_BLAST_STRIKE, ITEM_ANIM_UPDATE);
+            Item_8026AE84(ip, GE_SFX_BLAST_COLUMNS, 0x40, 0x7F);
+        }
+        return false;
+    }
+    return BV(ip).t >= BA(ip)->strike; /* the strike ends: gone */
+}
+
+static void itGe_Blast_Phys(Item_GObj* g)
+{
+    Item* ip = GET_ITEM(g);
+    ip->x40_vel.x = ip->x40_vel.z = 0.0f;
+    ip->x40_vel.y = BV(ip).phase == GE_BLAST_STRIKE ? -BA(ip)->drop / BA(ip)->strike : 0.0f;
+}
+
+static bool itGe_Blast_Coll(Item_GObj* g)
+{
+    return false;
+}
