+++ b/src/melee/gr/grforest.h
@@ -0,0 +1,16 @@
+#ifndef MELEE_GR_GRFOREST_H
+#define MELEE_GR_GRFOREST_H
+/* animation-pipeline: the Forest Maze stage (SMRPG), a static starter. Its archive is GrFm.dat, built by datkit
+ * stage-build from projects/geno/stage (layout A, "Clearing"). It takes the game's unused Akaneia slot: StKind 0x15
+ * (St_Kind_Akaneia) already maps to GrKind 0x1A (Gr_Kind_Unk26), whose stage_datas entry is NULL in the vanilla game;
+ * ground.c points it at grFm_StageData in non-matching builds. The stage select stores stage kinds in a u8, which is why
+ * a new kind past 0xFF could not be used. */
+
+#include <melee/gr/forward.h>
+
+#define GR_KIND_FOREST_MAZE Gr_Kind_Unk26 /* 0x1A */
+#define ST_KIND_FOREST_MAZE St_Kind_Akaneia /* 0x15 */
+
+extern StageData grFm_StageData;
+
+#endif
