+                OSReport("GP %d %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f\n", i, pj->mtx[0][0], pj->mtx[0][1],
+                         pj->mtx[0][2], pj->mtx[1][0], pj->mtx[1][1], pj->mtx[1][2], pj->mtx[2][0], pj->mtx[2][1],
+                         pj->mtx[2][2]);
+            }
+            OSReport("GC %d", i);
+            for (d = fp->dynamic_bone_sets[i].dyn_desc.data; d != NULL; d = d->next) {
+                OSReport(" %.3f %.3f %.3f", d->desc.lb_unk0.unk_2C.x, d->desc.lb_unk0.unk_2C.y,
+                         d->desc.lb_unk0.unk_2C.z);
+            }
+            OSReport("\n");
+            if (geno_dyn_frame[fp->player_idx & 3] % 60 == 1) {
+                for (d = fp->dynamic_bone_sets[i].dyn_desc.data; d != NULL; d = d->next) {
+                    HSD_JObj* j = d->desc.lb_unk0.jobj;
+                    OSReport("GJ %d %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f\n", i, j->translate.x, j->translate.y,
+                             j->translate.z, j->scale.x, j->scale.y, j->scale.z, j->rotate.x, j->rotate.y, j->rotate.z);
+                }
+            }
+        }
+        for (i = 0; i < (int) fp->x166C; i++) {
+            OSReport("GS %d %.3f %.3f %.3f %.2f\n", i, fp->x1670[i].x18.x, fp->x1670[i].x18.y,
+                     fp->x1670[i].x18.z, fp->x1670[i].v2);
+        }
+    }
