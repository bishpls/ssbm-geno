+    if (star) {
+        HSD_JObjSetFlags(trail, JOBJ_HIDDEN);
+        HSD_JObjSetFlags(head, JOBJ_HIDDEN);
+        HSD_JObjClearFlags(st, JOBJ_HIDDEN);
+    } else {
+        HSD_JObjSetFlags(st, JOBJ_HIDDEN);
+    }
+}
