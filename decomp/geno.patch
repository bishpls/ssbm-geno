+/* the up throw's shots (state 3, spawned by the throw's laser call): SMRPG's Star Gun stars, each a spinning gold star
+ * that drops a sparkle trail (EFGE_THROW_STAR_TRAIL) every other frame; the laser's flight and hitboxes as before */
+#define GE_THROWSTAR_LEVEL 0.3f
