     if (dynamics_num != 0 && stage_info.grkind == Gr_Kind_Flatzone) {
@@ -427,6 +433,48 @@ void ftCo_8009DD94(Fighter_GObj* gobj, bool arg1)
             dyn++;
         }
     }
+#if !defined(MUST_MATCH) && defined(GENO_DYN_TRACE)
+    /* animation-pipeline: Geno's chains every frame, for tuning (animation-pipeline projects/geno/rig/dynsim.py replays
+     * them): GDYN frame, port, motion, position, facing, ground/air, kind and this solve's cost; per chain GP (its parent's
+     * rotation) and GC (its joints as solved); GS the collision spheres; every 60 frames GJ (the chain joints' local
+     * translate, scale and rotate) */
+    if (fp->kind == Ft_Kind_Geno || fp->kind == Ft_Kind_Mars) { /* Marth: the vanilla reference */
+        static int geno_dyn_frame[4];
+        struct DynamicsData* d;
+        /* the last field: this solve's cost in OS timer ticks (bus clock / 4, 40.5 MHz; a frame is 675,000) */
+        OSReport("GDYN %d %d %d %.2f %.2f %.0f %d %d %d\n", geno_dyn_frame[fp->player_idx & 3]++, fp->player_idx,
+                 fp->motion_id, fp->cur_pos.x, fp->cur_pos.y, fp->facing_dir, fp->ground_or_air, fp->kind,
+                 (int) (OSGetTick() - geno_dyn_t0));
