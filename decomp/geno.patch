+/* the charge (ground and air): the second star, the release, the third star */
+static void ftGe_Lw_Anim(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    int f = ++fp->mv.ge.frames;
+    bool held = (fp->input.held_buttons[0] & HSD_PAD_B) != 0;
+    if (!(held && f == BLAST_WIDEN_FRAME)) {
+        ftGe_BlastSteer(gobj, held, !held); /* until star 2 (below) or B let go: the stick moves the mark */
+    }
+    if (held && f == BLAST_WIDEN_FRAME && fp->mv.ge.stars < 2) {
+        fp->mv.ge.stars = 2;
+        OSReport("GENO BLAST star 2 move frame %d\n", f + 1);
+        ft_PlaySFX(fp, GE_SFX_BLAST_STAR2, 0x7F, 0x40);
+        ftGe_BlastSides(gobj); /* v1.5: the lock, and all three marks as the second star lights */
+    }
+    if (held && f == BLAST_FLASH_FRAME) {
+        if (fp->ground_or_air == GA_Ground) {
+            OSReport("GENO FLASH instead of the Blast, move frame %d\n", f + 1);
+            itGe_BlastClear(gobj); /* v1.5: the cannon commits: the marks go */
