+
+static void ftGe_Hi_Coll(Fighter_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    bool floor;
+    if (fp->mv.ge.frames >= STARROAD_LEDGE_FROM) {
+        /* the ledge-aware collision (Fox's Firefox uses it): a ledge he faces catches mid-travel. The plain air collision
+         * (ft_80081D0C) never looks for ledges, so before v1.3 the star only caught one after its travel. As for everyone,
+         * only while descending (mpcoll.c's ledge search needs y falling): a rising star pops over and catches falling */
+        floor = ft_CheckGroundAndLedge(gobj, fp->facing_dir < 0.0f ? CLIFFCATCH_LEFT : CLIFFCATCH_RIGHT);
+        if (ftCliffCommon_80081298(gobj)) {
+            return; /* caught the ledge */
+        }
+    } else {
+        floor = ft_80081D0C(gobj);
+    }
+    if ((fp->coll_data.env_flags & Collide_WallMask) && !(fp->coll_data.env_flags & Collide_CeilingMask) &&
+        (fp->mv.ge.vy > STARROAD_WALL_SLIDE || fp->mv.ge.vy < -STARROAD_WALL_SLIDE))
+    {
+        /* steeply into a wall, the star hugs it: the wall takes the sideways part and he flies on along it. Up, he pops
+         * over the ledge and catches it falling; down, he drops past it into the ledge's reach (a stage's undercut wall
+         * sits right under the ledge, so a dive that bonked there never came in range) */
+        if (fp->mv.ge.vx != 0.0f) {
+            OSReport("GENO STARROAD slide frame %d\n", fp->mv.ge.frames);
+            fp->mv.ge.vx = 0.0f;
+            fp->self_vel.x = 0.0f;
+        }
+        return;
+    }
+    if (fp->coll_data.env_flags & (Collide_WallMask | Collide_CeilingMask)) {
+        /* level into a wall, or into the stage's underside, stops the star dead: a low recovery still has to be aimed */
+        OSReport("GENO STARROAD bonk frame %d\n", fp->mv.ge.frames);
+        ftPartSetRotX(fp, ftParts_GetBoneIndex(fp, FtPart_XRotN), 0.0f);
+        fp->self_vel.x = fp->self_vel.y = 0.0f;
+        ftCo_80096900(gobj, 1, 0, true, STARROAD_FREEFALL_MOBILITY, STARROAD_LANDING_LAG);
+        return;
+    }
+    if (floor && fp->mv.ge.vy <= 0.0f) {
+        ftPartSetRotX(fp, ftParts_GetBoneIndex(fp, FtPart_XRotN), 0.0f);
+        ftCo_LandingFallSpecial_Enter(gobj, false, STARROAD_LANDING_LAG);
+    }
+}
