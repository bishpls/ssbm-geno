diff --git a/src/melee/gr/grforest.c b/src/melee/gr/grforest.c
new file mode 100644
index 0000000..bf9d84d
--- /dev/null
+++ b/src/melee/gr/grforest.c
@@ -0,0 +1,135 @@
+/* animation-pipeline: the Forest Maze stage (grforest.h). A static starter on Battlefield's pattern (grbattle.c) without
+ * its background swaps or demo placement. Map gobjs, as stage-build writes them (projects/geno/stage/stage_spec.py):
+ *   0  the general points (spawns, camera range, blast zones, items)
+ *   1  the play plane: the stump and the cap; the collision is unbound (static), updated as Battlefield's stage gobj is
+ *   2  the background
+ * No hazards, no yakumono_param, no touch-line dynamics. */
+#include "grforest.h"
+
+#include "granime.h"
+#include "grdisplay.h"
+#include "grlib.h"
+#include "grmaterial.h"
+#include "ground.h"
+#include "stage.h"
+#include "inlines.h"
+#include "types.h"
+
+#include <melee/lb/lb_00F9.h>
+#include <sysdolphin/baselib/gobj.h>
+#include <sysdolphin/baselib/gobjgxlink.h>
+#include <sysdolphin/baselib/gobjproc.h>
+#include <sysdolphin/baselib/jobj.h>
+#include <dolphin/os.h>
+
+static void grForest_OnInit(void);
+static void grForest_OnDemoInit(int);
+static void grForest_OnLoad(void);
+static void grForest_OnStart(void);
+static bool grForest_Callback4(void);
+static DynamicsDesc* grForest_OnTouchLine(enum_t);
+static bool grForest_OnCheckShadowRender(Vec3*, int, HSD_JObj*);
+
+static void grForest_Points_Init(Ground_GObj* gobj);
+static void grForest_Stage_Init(Ground_GObj* gobj);
+static void grForest_Stage_Proc(Ground_GObj* gobj);
+static void grForest_Back_Init(Ground_GObj* gobj);
+static bool grForest_False(Ground_GObj* gobj);
+static void grForest_Nop(Ground_GObj* gobj);
+
+static StageCallbacks grFm_StageCallbacks[] = {
+    { grForest_Points_Init, grForest_False, grForest_Nop, grForest_Nop, 0 },
+    { grForest_Stage_Init, grForest_False, grForest_Stage_Proc, grForest_Nop, (1 << 30) | (1 << 31) },
+    { grForest_Back_Init, grForest_False, grForest_Nop, grForest_Nop, 0 },
+};
+
+StageData grFm_StageData = {
+    GR_KIND_FOREST_MAZE,
+    grFm_StageCallbacks,
+    "/GrFm.dat",
+    grForest_OnInit,
+    grForest_OnDemoInit,
+    grForest_OnLoad,
+    grForest_OnStart,
+    grForest_Callback4,
+    grForest_OnTouchLine,
+    grForest_OnCheckShadowRender,
+    (1 << 0),
+    NULL,
+    0,
+};
+
+/* grBattle_80219D84's pattern: set up one map gobj with its callbacks */
+static Ground_GObj* grForest_SetupGObj(int gobj_id)
+{
+    HSD_GObj* gobj;
+    StageCallbacks* callbacks = &grFm_StageCallbacks[gobj_id];
+    gobj = Ground_GetStageGObj(gobj_id);
+    if (gobj != NULL) {
+        Ground* gp = GET_GROUND(gobj);
+        gp->x8_callback = NULL;
+        gp->xC_callback = NULL;
+        GObj_SetupGXLink(gobj, grDisplay_801C5DB0, 3, 0);
+        if (callbacks->callback3 != NULL) {
+            gp->x1C_callback = callbacks->callback3;
+        }
+        if (callbacks->on_init != NULL) {
+            callbacks->on_init(gobj);
+        }
+        if (callbacks->gobj_proc != NULL) {
+            HSD_GObj_SetupProc(gobj, callbacks->gobj_proc, 4);
+        }
+    } else {
+        OSReport("%s:%d: couldn t get gobj(id=%d)\n", __FILE__, __LINE__, gobj_id);
+    }
+    return gobj;
+}
+
+static void grForest_OnInit(void)
+{
+    OSReport("GRFOREST INIT grkind %d stkind %d\n", (int) stage_info.grkind, (int) Stage_80225194());
+    stage_info.unk8C.b4 = 1;
+    stage_info.unk8C.b5 = 1;
+    grForest_SetupGObj(0);
+    grForest_SetupGObj(2);
+    grForest_SetupGObj(1);
+    Ground_801C39C0(); /* the camera range, from points 148-150 */
+    Ground_801C3BB4(); /* the blast zones, from points 151-152 */
+    grLib_801C9A10();
+}
+
+static void grForest_OnDemoInit(int arg0) {}
+static void grForest_OnLoad(void) {}
+static void grForest_OnStart(void) {}
+static bool grForest_Callback4(void) { return false; }
+static DynamicsDesc* grForest_OnTouchLine(enum_t arg0) { return NULL; }
+static bool grForest_OnCheckShadowRender(Vec3* arg0, int arg1, HSD_JObj* arg2) { return true; }
+
+static void grForest_Points_Init(Ground_GObj* gobj)
+{
+    Ground* gp = GET_GROUND(gobj);
+    grAnime_801C8138(gobj, gp->map_id, 0);
+}
+
+static void grForest_Stage_Init(Ground_GObj* gobj)
+{
+    Ground_InitMapCollAndAnim(gobj);
+}
+
+static void grForest_Stage_Proc(Ground_GObj* gobj)
+{
+    Ground_UpdateMapColl(gobj);
+    lb_800115F4();
+}
+
+static void grForest_Back_Init(Ground_GObj* gobj)
+{
+    Ground* gp = GET_GROUND(gobj);
+    HSD_JObj* jobj = GET_JOBJ(gobj);
+    grAnime_801C8138(gobj, gp->map_id, 0);
+    grMaterial_801C94D8(jobj);
+    gp->x11_flags.b012 = 2;
+}
+
+static bool grForest_False(Ground_GObj* gobj) { return false; }
+static void grForest_Nop(Ground_GObj* gobj) {}
diff --git a/src/melee/gr/grforest.h b/src/melee/gr/grforest.h
